<%- include('../partials/professor-header') %>

<!-- Page Header -->
<div id="pdf-content" style="padding: 10px;">
<div class="page-header">
  <h1>📊 Dashboard Docente</h1>
  <p style="color:var(--text-secondary)">Bienvenido, Profesor/a <%= user.FirstName %> — Vista de Analítica y Rendimiento Estudiantil (Solo Lectura)</p>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Estudiantes Activos</h3>
      <div class="kpi-value" id="totalUsers"><%= kpis.totalUsers %></div>
    </div>
    <div class="kpi-icon">👥</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Finalización</h3>
      <div class="kpi-value" id="completionRate"><%= kpis.completionRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(16,185,129,0.1);color:var(--color-success);">✅</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Abandono</h3>
      <div class="kpi-value" style="color:var(--color-error);" id="abandonRate"><%= kpis.abandonRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(239,68,68,0.1);color:var(--color-error);">⚠️</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tiempo Promedio / Evaluación</h3>
      <div class="kpi-value" id="avgTime"><%= kpis.avgTimeMinutes %> min</div>
    </div>
    <div class="kpi-icon" style="background:rgba(245,158,11,0.1);color:var(--color-gold);">⏱️</div>
  </div>
</div>

<!-- Charts Row 1 -->
<div class="charts-grid" id="charts-section">
  <div class="chart-card">
    <h3>Tasa de Finalización por Semana</h3>
    <div class="chart-container"><canvas id="completionChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Tiempo Promedio por Evaluación (seg)</h3>
    <div class="chart-container"><canvas id="timeChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Efectividad por Módulo</h3>
    <div class="chart-container"><canvas id="effectivenessChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Actividad Últimos 7 Días</h3>
    <div class="chart-container"><canvas id="activityChart"></canvas></div>
  </div>
</div>

<!-- Charts Row 2 - Analítica Avanzada -->
<h2 style="margin: 2rem 0 1rem; font-size: 1.3rem; color: var(--accent-cyan); display:flex; align-items:center; gap:0.5rem;">🔬 Analítica Avanzada</h2>
<div class="charts-grid">
  <div class="chart-card">
    <h3>Pre-Test vs Módulos — Comparativo de Competencias</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Promedio grupal: Puntaje Pre-Test vs Desempeño en Módulos</p>
    <div class="chart-container"><canvas id="preVsModuleChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Distribución de Niveles de Jugador</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Cuántos estudiantes hay en cada nivel de XP</p>
    <div class="chart-container"><canvas id="levelDistChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🏆 Top 10 Estudiantes por XP</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Ranking de los mejores estudiantes</p>
    <div class="chart-container"><canvas id="topStudentsChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🤖 K-Means Clustering — Grupos de Rendimiento</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Clasificación automática de estudiantes por rendimiento</p>
    <div class="chart-container"><canvas id="clusterChart"></canvas></div>
    <div id="clusterLegend" style="margin-top:0.75rem;"></div>
  </div>
  <div class="chart-card" style="grid-column: 1 / -1;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:0.5rem; gap:0.5rem;">
      <h3 style="margin-bottom:0; border:none; padding:0;">🎯 Diagrama de Dispersión — Niveles MCER (Primera vs Última Prueba)</h3>
      <div style="display:flex; gap:1rem; font-size:0.85rem; align-items:center; flex-wrap:wrap;">
        <span style="display:inline-flex; align-items:center; gap:0.35rem; color:#06b6d4; font-weight:600;"><span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#06b6d4;"></span> Primera Prueba (Pre-Test)</span>
        <span style="display:inline-flex; align-items:center; gap:0.35rem; color:#a855f7; font-weight:600;"><span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#a855f7;"></span> Última Prueba (Post-Test)</span>
      </div>
    </div>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:0; margin-bottom:1rem;">Visualización de dispersión y agrupación de estudiantes según puntaje obtenido (eje horizontal) y nivel MCER alcanzado (eje vertical: A1 a C1). Permite contrastar de forma directa el diagnóstico inicial contra el examen final.</p>
    <div class="chart-container" style="height:350px;"><canvas id="scatterLevelsChart"></canvas></div>
  </div>
</div>

<!-- Users Table (Read-Only) -->
<div class="table-container" id="users-section">
  <div class="table-header-actions">
    <h2>Listado de Estudiantes</h2>
    <div style="display:flex;gap:0.5rem;align-items:center;">
      <input type="text" id="searchUsers" placeholder="🔍 Buscar estudiante..." class="form-control" style="width:200px;">
      <button onclick="exportToCSV()" class="btn-secondary" style="background:#06b6d4; color:white; border:none; border-radius:6px; padding:0.4rem 0.8rem; font-weight:600; cursor:pointer;">📥 CSV</button>
      <button onclick="exportDashboardPDF()" class="btn-secondary" style="background:#ef4444; color:white; border:none; border-radius:6px; padding:0.4rem 0.8rem; font-weight:600; cursor:pointer;">📄 PDF Informe</button>
    </div>
  </div>
  <div class="accordion-list" id="usersList">
    <% users.forEach(student => { %>
      <details class="user-accordion" data-user-id="<%= student.UserID %>">
        <summary class="user-summary">
          <div class="user-main-info">
            <strong><%= student.FirstName %> <%= student.LastName %></strong>
            <span class="badge-pill <%= student.IsActive ? 'active' : 'inactive' %>">
              <%= student.IsActive ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
          <div class="user-sub-info">
            <small><%= student.Email %></small>
            <small>Semana <%= student.CurrentWeek || 1 %> — <%= student.CurrentActivity || 'Sin actividad reciente' %></small>
          </div>
          <div class="user-quick-stats" style="margin-left:auto; display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
            <span class="badge" style="background:rgba(6,182,212,0.15); color:var(--accent-cyan); padding:2px 8px; border-radius:6px; font-size:0.8rem; font-weight:600;">📝 Pre: <%= student.PreTestScore != null ? Math.round(student.PreTestScore) + '%' : 'Pend.' %></span>
            <span class="badge" style="background:rgba(124,58,237,0.15); color:#a78bfa; padding:2px 8px; border-radius:6px; font-size:0.8rem; font-weight:600;">🎓 Post: <%= student.PostTestScore != null ? Math.round(student.PostTestScore) + '%' : 'Pend.' %></span>
            <span class="badge" style="background:rgba(245,158,11,0.15); color:var(--accent-gold); padding:2px 8px; border-radius:6px; font-size:0.8rem; font-weight:600;">Nv. <%= student.Level %></span>
            <span class="badge" style="background:rgba(239,68,68,0.15); color:#f97316; padding:2px 8px; border-radius:6px; font-size:0.8rem; font-weight:600;">🔥 <%= student.CurrentStreak %> d</span>
          </div>
        </summary>
        <div class="user-details-content">
          <div class="user-stats" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap:0.75rem; background:rgba(0,0,0,0.2); padding:0.75rem; border-radius:8px; margin-bottom:1rem;">
            <div><strong>ID:</strong> <%= student.UserID %></div>
            <div><strong>Pre-Test (1° Examen):</strong> <span style="color:var(--accent-cyan); font-weight:700;"><%= student.PreTestScore !== null && student.PreTestScore !== undefined ? Math.round(student.PreTestScore) + '%' : 'Pendiente' %></span></div>
            <div><strong>Post-Test (Último Examen):</strong> <span style="color:#a78bfa; font-weight:700;"><%= student.PostTestScore !== null && student.PostTestScore !== undefined ? Math.round(student.PostTestScore) + '%' : 'Pendiente' %></span></div>
            <div><strong>Nivel MCER:</strong> <%= student.EnglishLevel || 'Por definir' %></div>
            <div><strong>Promedio:</strong> <%= student.AvgScore !== null && student.AvgScore !== undefined ? Math.round(student.AvgScore) + '%' : '0%' %></div>
            <div><strong>Actividades:</strong> <%= student.CompletedCount || 0 %> completadas</div>
            <div><strong>Proyección Saber Pro:</strong> 🎯 <%= Math.round(((student.AvgScore || 0) / 100) * 300) %> / 300 pts</div>
            <div><strong>Último Acceso:</strong> <%= student.LastLoginAt ? new Date(student.LastLoginAt).toLocaleDateString('es-CO') : 'Nunca' %></div>
          </div>
          <div class="action-btns" style="display:flex; justify-content:flex-end;">
            <a href="/professor/students/<%= student.UserID %>/detail" class="btn-icon" title="Ver Analítica y Predicciones" style="background:rgba(6,182,212,0.15); color:var(--accent-cyan); text-decoration:none; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.9rem; font-weight:600; display:inline-flex; align-items:center; gap:0.4rem; border:1px solid rgba(6,182,212,0.3);">
              👁️ Ver Análisis Completo y Modelos IA →
            </a>
          </div>
        </div>
      </details>
    <% }); %>
  </div>
</div>
</div> <!-- End pdf-content -->

<%- include('../partials/admin-footer') %>
