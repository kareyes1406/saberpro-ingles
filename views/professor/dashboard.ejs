<%- include('../partials/professor-header') %>

<!-- Page Header -->
<div id="pdf-content" style="padding: 10px;">
<div class="page-header">
  <h1>📊 Dashboard Docente</h1>
  <p style="color:var(--text-secondary)">Bienvenido, Profesor/a <%= user.FirstName %> — Vista de Analítica y Rendimiento Estudiantil (Solo Lectura)</p>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Estudiantes Activos</h3>
      <div class="kpi-value" id="totalUsers"><%= kpis.totalUsers %></div>
    </div>
    <div class="kpi-icon">👥</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Finalización</h3>
      <div class="kpi-value" id="completionRate"><%= kpis.completionRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(16,185,129,0.1);color:var(--color-success);">✅</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Abandono</h3>
      <div class="kpi-value" style="color:var(--color-error);" id="abandonRate"><%= kpis.abandonRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(239,68,68,0.1);color:var(--color-error);">⚠️</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tiempo Promedio / Evaluación</h3>
      <div class="kpi-value" id="avgTime"><%= kpis.avgTimeMinutes %> min</div>
    </div>
    <div class="kpi-icon" style="background:rgba(245,158,11,0.1);color:var(--color-gold);">⏱️</div>
  </div>
</div>

<!-- Charts Row 1 -->
<div class="charts-grid" id="charts-section">
  <div class="chart-card">
    <h3>Tasa de Finalización por Semana</h3>
    <div class="chart-container"><canvas id="completionChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Tiempo Promedio por Evaluación (seg)</h3>
    <div class="chart-container"><canvas id="timeChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Efectividad por Módulo</h3>
    <div class="chart-container"><canvas id="effectivenessChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Actividad Últimos 7 Días</h3>
    <div class="chart-container"><canvas id="activityChart"></canvas></div>
  </div>
</div>

<!-- Charts Row 2 - Analítica Avanzada -->
<h2 style="margin: 2rem 0 1rem; font-size: 1.3rem; color: var(--accent-cyan); display:flex; align-items:center; gap:0.5rem;">🔬 Analítica Avanzada</h2>
<div class="charts-grid">
  <div class="chart-card">
    <h3>Pre-Test vs Módulos — Comparativo de Competencias</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Promedio grupal: Puntaje Pre-Test vs Desempeño en Módulos</p>
    <div class="chart-container"><canvas id="preVsModuleChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Distribución de Niveles de Jugador</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Cuántos estudiantes hay en cada nivel de XP</p>
    <div class="chart-container"><canvas id="levelDistChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🏆 Top 10 Estudiantes por XP</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Ranking de los mejores estudiantes</p>
    <div class="chart-container"><canvas id="topStudentsChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🤖 K-Means Clustering — Grupos de Rendimiento</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Clasificación automática de estudiantes por rendimiento</p>
    <div class="chart-container"><canvas id="clusterChart"></canvas></div>
    <div id="clusterLegend" style="margin-top:0.75rem;"></div>
  </div>
</div>

<!-- Users Table (Read-Only) -->
<div class="table-container" id="users-section">
  <div class="table-header-actions">
    <h2>Listado de Estudiantes</h2>
    <div style="display:flex;gap:0.5rem;align-items:center;">
      <input type="text" id="searchUsers" placeholder="🔍 Buscar estudiante..." class="form-control" style="width:220px;">
    </div>
  </div>
  <div class="accordion-list" id="usersList">
    <% users.forEach(student => { %>
      <div class="accordion-item" data-name="<%= (student.FirstName + ' ' + student.LastName).toLowerCase() %>" data-email="<%= student.Email.toLowerCase() %>">
        <div class="accordion-header" onclick="toggleAccordion(this)">
          <div class="user-meta">
            <div class="user-avatar"><%= student.FirstName.charAt(0) %><%= student.LastName.charAt(0) %></div>
            <div class="user-info">
              <span class="user-name"><%= student.FirstName %> <%= student.LastName %></span>
              <span class="user-email"><%= student.Email %></span>
            </div>
          </div>
          <div class="user-quick-stats">
            <span class="badge" style="background:rgba(6,182,212,0.1);color:var(--accent-cyan);">Semana <%= student.CurrentWeek || 1 %></span>
            <span class="badge" style="background:rgba(245,158,11,0.1);color:var(--accent-gold);">Nv. <%= student.Level %></span>
            <span class="badge" style="background:rgba(124,58,237,0.1);color:var(--accent-purple);"><%= student.TotalXP %> XP</span>
            <span class="badge" style="background:rgba(239,68,68,0.1);color:#f97316;">🔥 <%= student.CurrentStreak %></span>
          </div>
          <div class="accordion-actions" onclick="event.stopPropagation()">
            <a href="/professor/students/<%= student.UserID %>/detail" class="btn-icon" title="Ver Analítica y Predicciones" style="background:rgba(6,182,212,0.15); color:var(--accent-cyan); text-decoration:none; padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.85rem; font-weight:600; display:flex; align-items:center; gap:0.3rem;">
              👁️ Ver Análisis
            </a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
</div>

<script>
// Accordion Toggle
function toggleAccordion(header) {
  const item = header.parentElement;
  item.classList.toggle('open');
}

// Búsqueda en tiempo real
document.getElementById('searchUsers').addEventListener('input', function(e) {
  const query = e.target.value.toLowerCase().trim();
  document.querySelectorAll('#usersList .accordion-item').forEach(item => {
    const name = item.dataset.name;
    const email = item.dataset.email;
    if (name.includes(query) || email.includes(query)) {
      item.style.display = 'block';
    } else {
      item.style.display = 'none';
    }
  });
});
</script>

<%- include('../partials/admin-footer') %>
