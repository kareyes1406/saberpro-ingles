<%- include('../partials/header') %>

<main class="game-container">
    <div class="game-header">
        <div class="activity-info">
            <h1><%= activity.Title %></h1>
            <p><%= activity.Description %></p>
        </div>
        <div class="stats-bar">
            <div class="stat-badge xp-badge">
                <span class="icon">⭐</span>
                <span id="xpCounter"><%= studentStats.TotalXP %></span> XP
            </div>
            <div class="stat-badge coins-badge">
                <span class="icon">🪙</span>
                <span id="coinsCounter"><%= studentStats.TotalCoins || 0 %></span>
            </div>
            <div class="stat-badge level-badge">
                <span class="icon">🏆</span> Nvl <span id="levelCounter"><%= studentStats.Level %></span>
            </div>
        </div>
    </div>

    <div class="reading-layout">
        <!-- Reading Passage Section -->
        <div class="reading-content-area">
            <% if (passageTitle) { %>
                <h2 class="passage-title"><%= passageTitle %></h2>
            <% } %>
            <% if (passage) { %>
                <div class="reading-passage" id="readingPassage">
                    <%- passage.replace(/\n/g, '<br>') %>
                </div>
            <% } else { %>
                <div class="reading-passage" id="readingPassage">
                    <p>No passage provided.</p>
                </div>
            <% } %>
        </div>

        <!-- Question Section -->
        <div class="question-interaction-area">
            <div class="progress-indicator">
                <span>Pregunta <span id="currentQ">1</span> de <span id="totalQ"><%= questions ? questions.length : 0 %></span></span>
                <div class="progress-bar-track">
                    <div class="progress-bar-fill" id="progressBar" style="width: 0%"></div>
                </div>
            </div>

            <div class="question-area" id="questionArea">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>
</main>

<script id="questionsData" type="application/json"><%- JSON.stringify(questions || []) %></script>
<script>
    const activityId = <%= activity.ActivityID %>;
    const totalQuestions = <%= questions ? questions.length : 0 %>;
</script>

<%- include('../partials/footer') %>
