<%- include('../partials/header') %>

<main class="game-container">
    <div class="game-header">
        <div class="activity-info">
            <h1><%= activity.Title %></h1>
            <p><%= activity.Description %></p>
        </div>
        <div class="stats-bar">
            <div class="stat-badge xp-badge">
                <span class="icon">⭐</span>
                <span id="xpCounter"><%= studentStats.TotalXP %></span> XP
            </div>
            <div class="stat-badge coins-badge">
                <span class="icon">🪙</span>
                <span id="coinsCounter"><%= studentStats.TotalCoins || 0 %></span>
            </div>
            <div class="stat-badge level-badge">
                <span class="icon">🏆</span> Nvl <span id="levelCounter"><%= studentStats.Level %></span>
            </div>
        </div>
    </div>

    <div class="progress-indicator">
        <span>Pregunta <span id="currentQ">1</span> de <span id="totalQ"><%= questions.length %></span></span>
        <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progressBar" style="width: 0%"></div>
        </div>
    </div>

    <div class="question-area" id="questionArea">
        <!-- Rendered by JS -->
    </div>
</main>

<script id="questionsData" type="application/json"><%- JSON.stringify(questions) %></script>
<script>
    const activityId = <%= activity.ActivityID %>;
    const totalQuestions = <%= questions.length %>;
</script>

<%- include('../partials/footer') %>
