<%- include('../partials/header') %>

<div class="shop-container" style="max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem;">
    <div class="shop-header" style="display: flex; justify-content: space-between; align-items: center; background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(6,182,212,0.2)); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 1.5rem 2rem; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div class="shop-title">
            <h1 style="margin: 0; font-size: 1.8rem; color: #fff;">🛒 Tienda de Beneficios</h1>
            <p style="margin: 0.5rem 0 0; color: var(--text-secondary, #94a3b8);">Adquiere potenciadores y ventajas para acelerar tu aprendizaje</p>
        </div>
        <div class="coin-balance" style="display: flex; align-items: center; gap: 0.5rem; background: rgba(0,0,0,0.3); padding: 0.75rem 1.25rem; border-radius: 30px; border: 1px solid rgba(245,158,11,0.3);">
            <span class="coin-icon" style="font-size: 1.5rem;">🪙</span>
            <span class="coin-amount" id="userCoins" style="font-size: 1.4rem; font-weight: 800; color: #f59e0b;"><%= (typeof studentStats !== 'undefined' && studentStats) ? studentStats.TotalCoins : 0 %></span>
            <span style="font-size: 0.85rem; color: #94a3b8;">Monedas</span>
        </div>
    </div>

    <!-- Consejo de UDECIA -->
    <div class="shop-mascot-tip" style="display: flex; align-items: center; gap: 1.5rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 1.25rem; margin-bottom: 2.5rem;">
        <img src="/img/mascota/explicar1.png" alt="UDECIA" class="shop-udecia" style="width: 75px; height: 75px; object-fit: cover; border-radius: 50%; border: 2px solid var(--accent-cyan, #06b6d4); flex-shrink: 0;">
        <div class="shop-bubble" style="background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.25); border-radius: 12px; padding: 1rem 1.25rem; color: #e2e8f0; font-size: 0.95rem; line-height: 1.5;">
            <strong>💡 Consejo de UDECIA:</strong> ¡Usa tus monedas sabiamente! Las pociones de XP te ayudarán a subir de nivel más rápido y los escudos de racha protegerán tus días consecutivos si no puedes ingresar.
        </div>
    </div>

    <h2 class="section-title" style="color: #fff; font-size: 1.4rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">⚡ Artículos Disponibles</h2>
    <div class="shop-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        <% if (locals.items && items.length > 0) { %>
            <% const userCoins = (typeof studentStats !== 'undefined' && studentStats) ? studentStats.TotalCoins : 0; %>
            <% items.forEach(item => { %>
                <div class="shop-card" style="background: var(--bg-card, #1a2235); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s;">
                    <div>
                        <div class="shop-card-icon" style="font-size: 2.5rem; text-align: center; margin-bottom: 0.75rem;"><%= item.IconEmoji || '📦' %></div>
                        <h3 class="item-name" style="margin: 0 0 0.5rem; font-size: 1.15rem; color: #fff; text-align: center;"><%= item.ItemName %></h3>
                        <p class="item-desc" style="color: #94a3b8; font-size: 0.85rem; line-height: 1.4; margin-bottom: 1rem; text-align: center;"><%= item.Description %></p>
                        <% if (item.DurationMinutes) { %>
                            <div style="text-align: center; margin-bottom: 1rem;">
                                <span style="background: rgba(6,182,212,0.15); color: #06b6d4; font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 12px; font-weight: 500;">
                                    ⏱️ Duración: <%= item.DurationMinutes >= 60 ? (item.DurationMinutes / 60) + ' hora(s)' : item.DurationMinutes + ' min' %>
                                </span>
                            </div>
                        <% } %>
                    </div>
                    <div class="shop-card-action" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 1rem; margin-top: 0.5rem;">
                        <div class="item-price" style="font-size: 1.15rem; font-weight: 700; color: #f59e0b;">
                            🪙 <%= item.Price %>
                        </div>
                        <button class="btn-buy" 
                                data-item-id="<%= item.ItemID %>" 
                                data-price="<%= item.Price %>"
                                style="background: <%= userCoins >= item.Price ? 'linear-gradient(135deg, #7c3aed, #06b6d4)' : 'rgba(255,255,255,0.1)' %>; color: white; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: <%= userCoins >= item.Price ? 'pointer' : 'not-allowed' %>; transition: opacity 0.2s;"
                                <%= userCoins < item.Price ? 'disabled' : '' %>>
                            Comprar
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="color: #94a3b8;">No hay artículos disponibles en este momento.</p>
        <% } %>
    </div>

    <h2 class="section-title" style="color: #fff; font-size: 1.4rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">🎒 Mi Inventario</h2>
    <div class="inventory-list" id="inventoryList" style="display: flex; flex-direction: column; gap: 1rem;">
        <% if (locals.inventory && inventory.length > 0) { %>
            <% inventory.forEach(inv => { %>
                <% 
                    const isExpired = inv.ExpiresAt && new Date(inv.ExpiresAt) < new Date();
                    const isActive = inv.IsUsed && inv.ExpiresAt && !isExpired;
                    let statusLabel = 'En Mochila';
                    let statusColor = '#3b82f6';
                    
                    if (isActive) {
                        statusLabel = '🟢 Activo (' + new Date(inv.ExpiresAt).toLocaleTimeString('es-CO', {hour: '2-digit', minute:'2-digit'}) + ')';
                        statusColor = '#10b981';
                    } else if (inv.IsUsed) {
                        statusLabel = 'Consumido';
                        statusColor = '#94a3b8';
                    } else if (inv.ItemType === 'hint_token') {
                        statusLabel = '💡 Listo para Combates';
                        statusColor = '#f59e0b';
                    }
                %>
                <div class="inventory-item" style="background: var(--bg-card, #1a2235); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div style="font-size: 2rem;"><%= inv.IconEmoji || '🎒' %></div>
                        <div>
                            <h4 style="margin: 0; color: #fff; font-size: 1.05rem;"><%= inv.ItemName %></h4>
                            <p style="margin: 0.25rem 0 0; color: #94a3b8; font-size: 0.8rem;">
                                Comprado: <%= new Date(inv.PurchasedAt).toLocaleDateString('es-CO') %>
                                <% if (isActive) { %>
                                    • <span style="color: #10b981; font-weight: 600;">Expira a las <%= new Date(inv.ExpiresAt).toLocaleTimeString('es-CO', {hour: '2-digit', minute:'2-digit'}) %></span>
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span style="background: <%= statusColor %>22; color: <%= statusColor %>; border: 1px solid <%= statusColor %>44; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">
                            <%= statusLabel %>
                        </span>
                        <% if (!inv.IsUsed && (inv.ItemType === 'xp_booster' || inv.ItemType === 'streak_shield')) { %>
                            <button class="btn-use" data-inv-id="<%= inv.InventoryID %>" style="background: linear-gradient(135deg, #7c3aed, #06b6d4); color: white; border: none; padding: 0.4rem 0.9rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: transform 0.2s;">
                                Activar
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px; padding: 2rem; text-align: center; color: #94a3b8;">
                <p style="margin: 0; font-size: 1.1rem;">Tu inventario está vacío.</p>
                <p style="margin: 0.5rem 0 0; font-size: 0.85rem;">Completa actividades en el mapa para ganar monedas y comprar potenciadores.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
