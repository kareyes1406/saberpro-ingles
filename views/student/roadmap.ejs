<%- include('../partials/header') %>

<div class="roadmap-wrapper">
  <!-- Main Roadmap -->
  <div class="roadmap-container">
    <div class="path-line"></div>
    <div class="path-progress" id="pathProgress"></div>
    
    <h1 style="text-align:center;margin-bottom:0.5rem;">Ruta de Aprendizaje</h1>
    <p style="text-align:center;color:var(--text-secondary);margin-bottom:2rem;">Inglés Saber Pro — 4 Semanas</p>
    
    <div class="nodes-grid">
      <% weeks.forEach((week, index) => { %>
        <div class="week-row">
          <div class="week-node 
            <%= week.isCompleted ? 'completed' : (week.isAvailable ? 'available' : 'locked') %>
            <%= week.isBossWeek ? 'boss-node' : '' %>"
            data-week-id="<%= week.WeekID %>"
            data-week-number="<%= week.WeekNumber %>">
            
            <div class="node-circle">
              <% if (week.isBossWeek) { %>
                <span>💀</span>
              <% } else if (week.isCompleted) { %>
                <span>✓</span>
              <% } else { %>
                <span><%= week.WeekNumber %></span>
              <% } %>
            </div>
            
            <div class="node-info">
              <% if (week.isBossWeek) { %>
                <span style="color:var(--color-error);font-weight:700;font-size:0.75rem;text-transform:uppercase;">⚔️ CORTE <%= week.WeekNumber === 4 ? 1 : week.WeekNumber === 8 ? 2 : 3 %></span>
              <% } %>
              <h4>Semana <%= week.WeekNumber %></h4>
              <p><%= week.Title %></p>
              <p style="font-size:0.8rem;">
                <% if (week.isCompleted) { %>
                  <a href="<%= week.activityLink %>" style="color:var(--accent-cyan); text-decoration:none; font-weight:600; font-size:0.85rem;">✅ Completada (Ver)</a>
                <% } else if (week.isAvailable) { %>
                  <a href="<%= week.activityLink %>" class="btn btn-primary" style="padding:0.4rem 1rem;font-size:0.85rem;">Comenzar →</a>
                <% } else { %>
                  🔒 Bloqueada
                <% } %>
              </p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <!-- Post-Test Final Exam Section -->
    <div style="margin-top: 4rem; padding: 2rem; background: rgba(255,255,255,0.02); border: 2px dashed var(--accent-purple); border-radius: 16px; text-align: center;">
      <h3 style="color: var(--accent-gold); margin-top: 0;">🎓 Examen Final (Post-Test)</h3>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Demuestra todo lo que has aprendido. Este examen evalúa tu progreso final tras completar las 4 semanas.</p>
      <% if (allWeeksCompleted) { %>
        <button class="btn-primary" onclick="window.location.href='/exam/post-test'" style="font-size: 1.1rem; padding: 0.75rem 2rem;">🏆 Presentar Post-Test</button>
      <% } else { %>
        <button class="btn-primary" disabled style="opacity: 0.5; cursor: not-allowed; font-size: 1.1rem; padding: 0.75rem 2rem;">🔒 Bloqueado (Completa la Semana 4)</button>
      <% } %>
    </div>
  </div>
  
  <!-- Stats Sidebar -->
  <div class="stats-sidebar">
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">⚡</div>
      <div class="stat-value" id="xpValue"><%= studentStats.TotalXP %></div>
      <div class="stat-label">XP Total</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Puntos de experiencia ganados completando actividades.</div>
    </div>
    <div class="stat-card streak stat-tooltip-wrapper">
      <div class="stat-icon">🔥</div>
      <div class="stat-value" id="streakValue"><%= studentStats.CurrentStreak %></div>
      <div class="stat-label">Días de Racha</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Días consecutivos practicando. ¡Mantén el hábito diario!</div>
    </div>
    <div class="stat-card coins stat-tooltip-wrapper">
      <div class="stat-icon">🪙</div>
      <div class="stat-value" id="coinsValue"><%= studentStats.TotalCoins %></div>
      <div class="stat-label">Monedas</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Monedas virtuales que puedes gastar en la Tienda.</div>
    </div>
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">🏅</div>
      <div class="stat-value"><%= studentStats.Level %></div>
      <div class="stat-label">Nivel</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Tu nivel actual. Sube de nivel cada 100 puntos de XP.</div>
    </div>
    
    <!-- Badges Section -->
    <div class="stat-card" style="text-align:left;">
      <h4 style="margin-bottom:0.75rem;">🏆 Medallas</h4>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <% badges.forEach(badge => { %>
          <div <%- `style="text-align:center; opacity: ${badge.earned ? 1 : 0.3};"` %> title="<%= badge.BadgeName %>: <%= badge.Description %>">
            <div style="font-size:1.5rem;"><%= badge.IconUrl || '🏆' %></div>
            <div style="font-size:0.65rem;color:var(--text-muted);"><%= badge.BadgeName %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- Intro.js Tour Implementation -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intro.js/7.2.0/introjs.min.css">
<style>
  .introjs-tooltip { border-radius: 12px; background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--accent-cyan); max-width: 350px; }
  .introjs-arrow.top { border-bottom-color: var(--accent-cyan); }
  .introjs-arrow.bottom { border-top-color: var(--accent-cyan); }
  .introjs-arrow.left { border-right-color: var(--accent-cyan); }
  .introjs-arrow.right { border-left-color: var(--accent-cyan); }
  .introjs-button { background: var(--accent-purple); color: white; border: none; text-shadow: none; border-radius: 6px; }
  .introjs-button:hover { background: #9333ea; color: white; }
  .introjs-skipbutton { color: var(--text-muted); }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/intro.js/7.2.0/intro.min.js"></script>
<script>
  function startUdeciaTour() {
    const intro = introJs();
    intro.setOptions({
      nextLabel: 'Siguiente',
      prevLabel: 'Anterior',
      doneLabel: '¡Entendido!',
      skipLabel: 'Saltar',
      showProgress: true,
      showBullets: false,
      steps: [
        {
          element: document.querySelector('.roadmap-container h1'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/feliz1.png" style="width:70px;" alt="Udecia">
                    <div><b>¡Hola! Soy UDECIA.</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">Te daré un recorrido rápido por esta pantalla. ¡Haz clic en Siguiente!</span></div>
                  </div>`,
          position: 'bottom'
        },
        {
          element: document.querySelector('.nodes-grid'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/explicar1.png" style="width:70px;" alt="Udecia">
                    <div><b>Tu Mapa de 4 Semanas</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">Aquí verás tu progreso. Debes ir superando las actividades de cada semana para avanzar.</span></div>
                  </div>`,
          position: 'right'
        },
        {
          element: document.querySelector('.nav-stats'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/feliz1.png" style="width:70px;" alt="Udecia">
                    <div><b>Estadísticas Rápidas</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">En la barra superior siempre podrás ver tu Nivel actual, tus días de Racha y tus Monedas.</span></div>
                  </div>`,
          position: 'bottom'
        },
        {
          element: document.getElementById('xpValue') ? document.getElementById('xpValue').parentElement : document.querySelector('.stats-sidebar'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/feliz1.png" style="width:70px;" alt="Udecia">
                    <div><b>Tu Experiencia (XP)</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">¡Ganas XP por cada respuesta correcta! Al acumular 100 XP subirás de nivel.</span></div>
                  </div>`,
          position: 'left'
        },
        {
          element: document.getElementById('streakValue') ? document.getElementById('streakValue').parentElement : document.querySelector('.stats-sidebar'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/asombrada1.png" style="width:70px;" alt="Udecia">
                    <div><b>¡No pierdas tu Racha!</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">Este fuego 🔥 cuenta los días seguidos que has entrado. ¡Si fallas un día se apagará!</span></div>
                  </div>`,
          position: 'left'
        },
        {
          element: document.getElementById('coinsValue') ? document.getElementById('coinsValue').parentElement : document.querySelector('.stats-sidebar'),
          intro: `<div style="display:flex;align-items:center;gap:15px;text-align:left;">
                    <img src="/img/mascota/feliz1.png" style="width:70px;" alt="Udecia">
                    <div><b>Tus Monedas</b><br><span style="font-size:0.9rem;color:var(--text-secondary);">Las usarás en la tienda para comprar ayudas o pistas cuando un examen esté muy difícil.</span></div>
                  </div>`,
          position: 'left'
        }
      ]
    });
    intro.start();
  }

  // Auto-start tour if it's the user's first time or requested via URL
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('tour') || !localStorage.getItem('udeciaHomeTourDone')) {
      setTimeout(() => {
        startUdeciaTour();
        localStorage.setItem('udeciaHomeTourDone', 'true');
        
        // Remove ?tour=1 from URL so it doesn't loop on refresh
        if (urlParams.has('tour')) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      }, 500);
    }
  });
</script>

<%- include('../partials/footer') %>
