<%- include('../partials/header') %>

<div class="roadmap-wrapper">
  <!-- Main Roadmap -->
  <div class="roadmap-container">
    <div class="path-line"></div>
    <div class="path-progress" id="pathProgress"></div>
    
    <h1 style="text-align:center;margin-bottom:0.5rem;">Ruta de Aprendizaje</h1>
    <p style="text-align:center;color:var(--text-secondary);margin-bottom:2rem;">Inglés Saber Pro — 4 Semanas</p>
    
    <div class="nodes-grid">
      <% weeks.forEach((week, index) => { %>
        <div class="week-row">
          <div class="week-node 
            <%= week.isCompleted ? 'completed' : (week.isAvailable ? 'available' : 'locked') %>
            <%= week.isBossWeek ? 'boss-node' : '' %>"
            data-week-id="<%= week.WeekID %>"
            data-week-number="<%= week.WeekNumber %>">
            
            <div class="node-circle">
              <% if (week.isBossWeek) { %>
                <span>💀</span>
              <% } else if (week.isCompleted) { %>
                <span>✓</span>
              <% } else { %>
                <span><%= week.WeekNumber %></span>
              <% } %>
            </div>
            
            <div class="node-info">
              <% if (week.isBossWeek) { %>
                <span style="color:var(--color-error);font-weight:700;font-size:0.75rem;text-transform:uppercase;">⚔️ CORTE <%= week.WeekNumber === 4 ? 1 : week.WeekNumber === 8 ? 2 : 3 %></span>
              <% } %>
              <h4>Semana <%= week.WeekNumber %></h4>
              <p><%= week.Title %></p>
              <p style="font-size:0.8rem;">
                <% if (week.isCompleted) { %>
                  <a href="<%= week.activityLink %>" style="color:var(--accent-cyan); text-decoration:none; font-weight:600; font-size:0.85rem;">✅ Completada (Ver)</a>
                <% } else if (week.isAvailable) { %>
                  <a href="<%= week.activityLink %>" class="btn btn-primary" style="padding:0.4rem 1rem;font-size:0.85rem;">Comenzar →</a>
                <% } else { %>
                  🔒 Bloqueada
                <% } %>
              </p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <!-- Post-Test Final Exam Section -->
    <div style="margin-top: 4rem; padding: 2rem; background: rgba(255,255,255,0.02); border: 2px dashed var(--accent-purple); border-radius: 16px; text-align: center;">
      <h3 style="color: var(--accent-gold); margin-top: 0;">🎓 Examen Final (Post-Test)</h3>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Demuestra todo lo que has aprendido. Este examen evalúa tu progreso final tras completar las 4 semanas.</p>
      <% if (allWeeksCompleted) { %>
        <button class="btn-primary" onclick="window.location.href='/exam/post-test'" style="font-size: 1.1rem; padding: 0.75rem 2rem;">🏆 Presentar Post-Test</button>
      <% } else { %>
        <button class="btn-primary" disabled style="opacity: 0.5; cursor: not-allowed; font-size: 1.1rem; padding: 0.75rem 2rem;">🔒 Bloqueado (Completa la Semana 4)</button>
      <% } %>
    </div>
  </div>
  
  <!-- Stats Sidebar -->
  <div class="stats-sidebar">
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">⚡</div>
      <div class="stat-value" id="xpValue"><%= studentStats.TotalXP %></div>
      <div class="stat-label">XP Total</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Puntos de experiencia ganados completando actividades.</div>
    </div>
    <div class="stat-card streak stat-tooltip-wrapper">
      <div class="stat-icon">🔥</div>
      <div class="stat-value" id="streakValue"><%= studentStats.CurrentStreak %></div>
      <div class="stat-label">Días de Racha</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Días consecutivos practicando. ¡Mantén el hábito diario!</div>
    </div>
    <div class="stat-card coins stat-tooltip-wrapper">
      <div class="stat-icon">🪙</div>
      <div class="stat-value" id="coinsValue"><%= studentStats.TotalCoins %></div>
      <div class="stat-label">Monedas</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Monedas virtuales que puedes gastar en la Tienda.</div>
    </div>
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">🏅</div>
      <div class="stat-value"><%= studentStats.Level %></div>
      <div class="stat-label">Nivel</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Tu nivel actual. Sube de nivel cada 100 puntos de XP.</div>
    </div>
    
    <!-- Badges Section -->
    <div class="stat-card" style="text-align:left;">
      <h4 style="margin-bottom:0.75rem;">🏆 Medallas</h4>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <% badges.forEach(badge => { %>
          <div <%- `style="text-align:center; opacity: ${badge.earned ? 1 : 0.3};"` %> title="<%= badge.BadgeName %>: <%= badge.Description %>">
            <div style="font-size:1.5rem;"><%= badge.IconUrl || '🏆' %></div>
            <div style="font-size:0.65rem;color:var(--text-muted);"><%= badge.BadgeName %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- Custom UDECIA Interactive Tour -->
<style>
  #udecia-tour-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    z-index: 9998;
  }
  #udecia-tour-dialog {
    display: none;
    position: fixed;
    bottom: 30px; left: 50%;
    transform: translateX(-50%);
    width: 90%; max-width: 600px;
    background: var(--bg-card);
    border: 2px solid var(--accent-cyan);
    border-radius: 16px;
    z-index: 10000;
    padding: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.9), 0 0 20px rgba(6, 182, 212, 0.4);
    align-items: center;
    gap: 20px;
    animation: slideUpTour 0.4s ease-out;
  }
  @keyframes slideUpTour {
    from { bottom: -100px; opacity: 0; }
    to { bottom: 30px; opacity: 1; }
  }
  .tour-highlighted-element {
    position: relative !important;
    z-index: 9999 !important;
    box-shadow: 0 0 0 4px var(--accent-cyan), 0 0 20px var(--accent-cyan) !important;
    background: var(--bg-card) !important;
    border-radius: 8px !important;
    transition: all 0.3s;
  }
  .navbar.tour-active-nav {
     z-index: 9999 !important;
     position: relative !important;
  }
</style>

<div id="udecia-tour-overlay"></div>
<div id="udecia-tour-dialog">
  <img id="tour-img" src="/img/mascota/saludar.png" style="width:100px; height:auto; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));">
  <div style="flex:1;">
    <h3 id="tour-title" style="margin-top:0; margin-bottom:8px; color:var(--accent-cyan); font-size:1.3rem;">Título</h3>
    <p id="tour-text" style="font-size:1rem; margin-bottom:15px; color:var(--text-primary); line-height:1.4;">Texto</p>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <button id="tour-prev" class="btn-secondary" style="padding:0.4rem 1rem; font-size:0.9rem;" onclick="tourChangeStep(-1)">Anterior</button>
      <span id="tour-progress" style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">1/5</span>
      <button id="tour-next" class="btn-primary" style="padding:0.4rem 1rem; font-size:0.9rem;" onclick="tourChangeStep(1)">Siguiente</button>
    </div>
  </div>
</div>

<script>
  const tourSteps = [
    {
      el: null,
      img: '/img/mascota/saludar.png',
      title: '¡Hola! Soy UDECIA',
      text: 'Estoy muy feliz de verte. Te daré un recorrido rápido por tu Ruta de Aprendizaje para que sepas usar todo en esta pantalla.'
    },
    {
      el: '.roadmap-container',
      img: '/img/mascota/explicar1.png',
      title: 'Tu Mapa de 4 Semanas',
      text: 'Aquí verás tu progreso. Deberás completar las actividades de cada semana para desbloquear la siguiente.'
    },
    {
      el: '.nav-stats',
      img: '/img/mascota/explicar2.png',
      title: 'Estadísticas Rápidas',
      text: 'En la barra superior siempre podrás ver tu Nivel actual, los días de racha que llevas y tus monedas acumuladas.'
    },
    {
      el: '#xpValue',
      img: '/img/mascota/celebrar1.png',
      title: 'Tu Experiencia (XP)',
      text: '¡Ganas XP por cada respuesta correcta en los juegos! Al acumular 100 XP subirás de nivel.'
    },
    {
      el: '#streakValue',
      img: '/img/mascota/pensar1.png',
      title: '¡No pierdas tu Racha!',
      text: 'Este fuego cuenta los días seguidos que has entrado a estudiar. ¡Si fallas un día se apagará por completo!'
    },
    {
      el: '#coinsValue',
      img: '/img/mascota/explicar1.png',
      title: 'Tus Monedas',
      text: 'Las monedas son tu recompensa. Úsalas en la tienda para comprar ayudas o pistas cuando un nivel esté muy difícil.'
    }
  ];

  let currentStep = 0;

  function startUdeciaTour() {
    document.getElementById('udecia-tour-overlay').style.display = 'block';
    document.getElementById('udecia-tour-dialog').style.display = 'flex';
    currentStep = 0;
    renderTourStep();
  }

  function tourChangeStep(dir) {
    currentStep += dir;
    if (currentStep >= tourSteps.length) {
        closeTour();
    } else {
        renderTourStep();
    }
  }

  function closeTour() {
    document.getElementById('udecia-tour-overlay').style.display = 'none';
    document.getElementById('udecia-tour-dialog').style.display = 'none';
    document.querySelectorAll('.tour-highlighted-element').forEach(el => el.classList.remove('tour-highlighted-element'));
    const nav = document.querySelector('.navbar');
    if(nav) nav.classList.remove('tour-active-nav');
  }

  function renderTourStep() {
    // Limpiar destacados anteriores
    document.querySelectorAll('.tour-highlighted-element').forEach(el => el.classList.remove('tour-highlighted-element'));
    const nav = document.querySelector('.navbar');
    if(nav) nav.classList.remove('tour-active-nav');

    const step = tourSteps[currentStep];
    
    // Destacar elemento si existe
    if (step.el) {
        let targetEl = document.querySelector(step.el);
        if (targetEl && step.el.includes('Value')) {
            targetEl = targetEl.parentElement; // Subir al contenedor padre (la tarjeta)
        }
        
        if (targetEl) {
            targetEl.classList.add('tour-highlighted-element');
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Si el elemento está en la barra de navegación, darle z-index a la barra
            if (step.el === '.nav-stats' && nav) {
                nav.classList.add('tour-active-nav');
            }
        }
    }

    // Actualizar contenido del diálogo
    document.getElementById('tour-img').src = step.img;
    document.getElementById('tour-title').innerText = step.title;
    document.getElementById('tour-text').innerText = step.text;
    document.getElementById('tour-progress').innerText = (currentStep + 1) + ' / ' + tourSteps.length;
    
    document.getElementById('tour-prev').style.visibility = currentStep === 0 ? 'hidden' : 'visible';
    document.getElementById('tour-next').innerText = currentStep === tourSteps.length - 1 ? '¡Finalizar!' : 'Siguiente';
  }

  // Auto-start tour
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('tour') || !localStorage.getItem('udeciaHomeTourDone')) {
      setTimeout(() => {
        startUdeciaTour();
        localStorage.setItem('udeciaHomeTourDone', 'true');
        if (urlParams.has('tour')) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      }, 500);
    }
  });
</script>

<%- include('../partials/footer') %>
