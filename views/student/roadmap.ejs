<%- include('../partials/header') %>

<div class="roadmap-wrapper">
  <!-- Main Roadmap -->
  <div class="roadmap-container">
    <div class="path-line"></div>
    <div class="path-progress" id="pathProgress"></div>
    
    <h1 style="text-align:center;margin-bottom:0.5rem;">Ruta de Aprendizaje <button id="mapInfoBtn" title="¿Cómo funciona?" style="background:rgba(124,58,237,0.2); border:2px solid var(--accent-purple, #7c3aed); color:#a78bfa; font-size:1.1rem; width:32px; height:32px; border-radius:50%; cursor:pointer; vertical-align:middle; margin-left:0.5rem; font-weight:800; transition:all 0.2s;" onmouseover="this.style.background='rgba(124,58,237,0.5)'" onmouseout="this.style.background='rgba(124,58,237,0.2)'">!</button></h1>
    <p style="text-align:center;color:var(--text-secondary);margin-bottom:1rem;">Inglés Saber Pro — 4 Semanas</p>
    
    <% if (typeof studentLevel !== 'undefined' && studentLevel) { %>
      <div style="display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:2rem;">
        <div style="background:rgba(124, 58, 237, 0.15); border:1px solid <%= levelInfo ? levelInfo.color : '#7c3aed' %>; padding:0.4rem 1.25rem; border-radius:30px; display:inline-flex; align-items:center; gap:0.5rem;">
          <span style="font-size:1.1rem;"><%= levelInfo ? levelInfo.icon : '🎯' %></span>
          <span style="font-weight:700; color:#fff; font-size:0.9rem;">Tu Nivel MCER: <strong style="color:<%= levelInfo ? levelInfo.color : '#a78bfa' %>;"><%= studentLevel %></strong> (<%= levelInfo ? levelInfo.name : '' %>)</span>
        </div>
        <div style="background:rgba(6, 182, 212, 0.12); border:1px solid #06b6d4; padding:0.4rem 1rem; border-radius:30px; font-size:0.85rem; color:#06b6d4; font-weight:600; display:inline-flex; align-items:center; gap:0.4rem;">
          <span>🤖</span> Contenido Personalizado por IA
        </div>
      </div>
    <% } %>
      <% weeks.forEach((week, index) => { %>
        <div class="week-row">
          <div class="week-node 
            <%= week.isCompleted ? 'completed' : (week.isAvailable ? 'available' : 'locked') %>
            <%= week.isBossWeek ? 'boss-node' : '' %>"
            data-week-id="<%= week.WeekID %>"
            data-week-number="<%= week.WeekNumber %>">
            
            <div class="node-circle">
              <% if (week.isBossWeek) { %>
                <span>💀</span>
              <% } else if (week.isCompleted) { %>
                <span>✓</span>
              <% } else { %>
                <span><%= week.WeekNumber %></span>
              <% } %>
            </div>
            
            <div class="node-info">
              <% if (week.isBossWeek) { %>
                <span style="color:var(--color-error);font-weight:700;font-size:0.75rem;text-transform:uppercase;">⚔️ CORTE <%= week.WeekNumber === 4 ? 1 : week.WeekNumber === 8 ? 2 : 3 %></span>
              <% } %>
              <h4>Semana <%= week.WeekNumber %></h4>
              <p><%= week.Title %></p>
              <p style="font-size:0.8rem;">
                <% if (week.isCompleted) { %>
                  <a href="<%= week.activityLink %>" style="color:var(--accent-cyan); text-decoration:none; font-weight:600; font-size:0.85rem;">✅ Completada (Ver)</a>
                <% } else if (week.isAvailable) { %>
                  <a href="<%= week.activityLink %>" class="btn btn-primary" style="padding:0.4rem 1rem;font-size:0.85rem;">Comenzar →</a>
                <% } else { %>
                  🔒 Bloqueada
                <% } %>
              </p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <!-- Post-Test Final Exam Section -->
    <div style="margin-top: 4rem; padding: 2rem; background: rgba(255,255,255,0.02); border: 2px dashed var(--accent-purple); border-radius: 16px; text-align: center;">
      <h3 style="color: var(--accent-gold); margin-top: 0;">🎓 Examen Final (Post-Test)</h3>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Demuestra todo lo que has aprendido. Este examen evalúa tu progreso final tras completar las 4 semanas.</p>
      <% if (allWeeksCompleted) { %>
        <button class="btn-primary" onclick="window.location.href='/exam/post-test'" style="font-size: 1.1rem; padding: 0.75rem 2rem;">🏆 Presentar Post-Test</button>
      <% } else { %>
        <button class="btn-primary" disabled style="opacity: 0.5; cursor: not-allowed; font-size: 1.1rem; padding: 0.75rem 2rem;">🔒 Bloqueado (Completa la Semana 4)</button>
      <% } %>
    </div>
  </div>
  
  <!-- Stats Sidebar -->
  <div class="stats-sidebar">
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">⚡</div>
      <div class="stat-value" id="xpValue"><%= studentStats.TotalXP %></div>
      <div class="stat-label">XP Total</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Puntos de experiencia ganados completando actividades.</div>
    </div>
    <div class="stat-card streak stat-tooltip-wrapper">
      <div class="stat-icon">🔥</div>
      <div class="stat-value" id="streakValue"><%= studentStats.CurrentStreak %></div>
      <div class="stat-label">Días de Racha</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Días consecutivos practicando. ¡Mantén el hábito diario!</div>
    </div>
    <div class="stat-card coins stat-tooltip-wrapper">
      <div class="stat-icon">🪙</div>
      <div class="stat-value" id="coinsValue"><%= studentStats.TotalCoins %></div>
      <div class="stat-label">Monedas</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Monedas virtuales que puedes gastar en la Tienda.</div>
    </div>
    <div class="stat-card stat-tooltip-wrapper">
      <div class="stat-icon">🏅</div>
      <div class="stat-value"><%= studentStats.Level %></div>
      <div class="stat-label">Nivel</div>
      <div class="stat-tooltip" style="bottom: auto; top: 100%; left: 50%;">Tu nivel actual. Sube de nivel cada 100 puntos de XP.</div>
    </div>
    
    <!-- Ranking Section -->
    <div class="stat-card" id="rankingCard" style="text-align:left;">
      <h4 style="margin-bottom:0.75rem; display:flex; align-items:center; justify-content:space-between;">🏅 Ranking de Jugadores <span style="font-size:0.7rem; color:var(--accent-cyan); font-weight:normal; cursor:pointer;" onclick="loadRanking()">🔄 Actualizar</span></h4>
      <div id="rankingList" style="font-size:0.85rem;">
        <div style="text-align:center; color:var(--text-muted); padding:1rem 0;"><div class="spinner" style="width:24px;height:24px;margin:0 auto;"></div><br>Cargando ranking...</div>
      </div>
    </div>
    
    <!-- Badges Section -->
    <div class="stat-card" style="text-align:left;">
      <h4 style="margin-bottom:0.75rem;">🏆 Medallas</h4>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <% badges.forEach(badge => { %>
          <div <%- `style="text-align:center; opacity: ${badge.earned ? 1 : 0.3};"` %> title="<%= badge.BadgeName %>: <%= badge.Description %>">
            <div style="font-size:1.5rem;"><%= badge.IconUrl || '🏆' %></div>
            <div style="font-size:0.65rem;color:var(--text-muted);"><%= badge.BadgeName %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Cómo funciona el Mapa de Fortalezas -->
<div id="mapInfoModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(10,14,26,0.85); backdrop-filter:blur(8px); z-index:2000; justify-content:center; align-items:center;">
  <div style="background:var(--bg-surface, #111827); padding:2rem 2.5rem; border-radius:16px; width:520px; max-width:92%; border:1px solid rgba(255,255,255,0.1); box-shadow:0 20px 40px rgba(0,0,0,0.5); position:relative;">
    <button onclick="document.getElementById('mapInfoModal').style.display='none'" style="position:absolute; top:1rem; right:1rem; background:none; border:none; color:var(--text-muted); font-size:1.5rem; cursor:pointer;">&times;</button>
    <h2 style="margin-top:0; color:var(--accent-cyan, #06b6d4); display:flex; align-items:center; gap:0.5rem;">ℹ️ ¿Cómo funciona el Mapa?</h2>
    <div style="color:var(--text-secondary, #cbd5e1); font-size:0.95rem; line-height:1.7;">
      <p><strong>🗺️ Ruta de Aprendizaje:</strong> Tu mapa muestra 4 semanas de contenido. Cada semana tiene sub-módulos con actividades interactivas de Vocabulario, Lectura, Gramática y Pragmática.</p>
      <p><strong>🔓 Desbloqueo Progresivo:</strong> Debes completar TODAS las actividades de una semana para desbloquear la siguiente. Las semanas bloqueadas aparecen en gris.</p>
      <p><strong>💀 Batallas de Jefe:</strong> Al final de cada semana hay una "Boss Battle" — un examen de corte con 15 preguntas que debes aprobar con mínimo 75%.</p>
      <p><strong>⭐ Recompensas:</strong> Cada actividad te da XP (experiencia), monedas y posibilidad de ganar medallas. Tu nivel sube cada 100 XP.</p>
      <p><strong>🤖 IA Adaptativa:</strong> La plataforma personaliza las preguntas según tu nivel MCER detectado en el pre-test diagnóstico.</p>
      <p><strong>🏆 Ranking:</strong> Compite con tus compañeros. Los primeros en completar actividades aparecerán en el ranking en tiempo real.</p>
    </div>
    <div style="text-align:center; margin-top:1.5rem;">
      <button onclick="document.getElementById('mapInfoModal').style.display='none'" style="background:var(--color-primary, #7c3aed); color:white; border:none; padding:0.6rem 2rem; border-radius:8px; font-weight:600; cursor:pointer; font-size:1rem;">¡Entendido!</button>
    </div>
  </div>
</div>

<%- include('../partials/udecia-tour') %>
<script>
  const roadmapTourSteps = [
    {
      el: null,
      img: '/img/mascota/saludar.png',
      title: '¡Hola! Soy UDECIA',
      text: 'Estoy muy feliz de verte. Te daré un recorrido rápido por tu Ruta de Aprendizaje para que sepas usar todo en esta pantalla.'
    },
    {
      el: '.roadmap-container',
      img: '/img/mascota/explicar1.png',
      title: 'Tu Mapa de 4 Semanas',
      text: 'Aquí verás tu progreso. Deberás completar las actividades de cada semana para desbloquear la siguiente.'
    },
    {
      el: '.nav-stats',
      img: '/img/mascota/explicar2.png',
      title: 'Estadísticas Rápidas',
      text: 'En la barra superior siempre podrás ver tu Nivel actual, los días de racha que llevas y tus monedas acumuladas.'
    },
    {
      el: '#xpValue',
      img: '/img/mascota/celebrar1.png',
      title: 'Tu Experiencia (XP)',
      text: '¡Ganas XP por cada respuesta correcta en los juegos! Al acumular 100 XP subirás de nivel.'
    },
    {
      el: '#streakValue',
      img: '/img/mascota/pensar1.png',
      title: '¡No pierdas tu Racha!',
      text: 'Este fuego cuenta los días seguidos que has entrado a estudiar. ¡Si fallas un día se apagará por completo!'
    },
    {
      el: '#coinsValue',
      img: '/img/mascota/explicar1.png',
      title: 'Tus Monedas',
      text: 'Las monedas son tu recompensa. Úsalas en la tienda para comprar ayudas o pistas cuando un nivel esté muy difícil.'
    }
  ];

  // Map Info Modal
  document.getElementById('mapInfoBtn').addEventListener('click', () => {
    document.getElementById('mapInfoModal').style.display = 'flex';
  });
  document.getElementById('mapInfoModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('mapInfoModal')) {
      document.getElementById('mapInfoModal').style.display = 'none';
    }
  });

  // Ranking System
  async function loadRanking() {
    try {
      const res = await fetch('/student/ranking');
      const data = await res.json();
      const list = document.getElementById('rankingList');
      if (data.ranking && data.ranking.length > 0) {
        const medals = ['🥇', '🥈', '🥉'];
        list.innerHTML = data.ranking.map((r, i) => `
          <div style="display:flex; align-items:center; gap:0.5rem; padding:0.4rem 0.5rem; border-radius:8px; margin-bottom:0.3rem; background:${i < 3 ? 'rgba(245,158,11,0.08)' : 'transparent'}; ${r.isCurrentUser ? 'border:1px solid var(--accent-cyan, #06b6d4);' : ''}">
            <span style="font-size:${i < 3 ? '1.2rem' : '0.85rem'}; min-width:24px; text-align:center; font-weight:700; color:${i < 3 ? '#f59e0b' : 'var(--text-muted)'}">${i < 3 ? medals[i] : (i + 1)}</span>
            <span style="flex:1; font-weight:${i < 3 ? '700' : '500'}; color:${r.isCurrentUser ? 'var(--accent-cyan)' : 'var(--text-primary)'}; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${r.FirstName} ${r.LastName.charAt(0)}.${r.isCurrentUser ? ' (Tú)' : ''}</span>
            <span style="font-size:0.75rem; color:var(--text-muted);">${r.CompletedActivities} ✅</span>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p style="text-align:center; color:var(--text-muted); font-size:0.85rem;">Aún no hay datos de ranking.</p>';
      }
    } catch (err) {
      console.error('Ranking Error:', err);
    }
  }
  loadRanking();
  // Auto-refresh ranking every 30 seconds
  setInterval(loadRanking, 30000);

  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('tour') || !localStorage.getItem('udeciaHomeTourDone')) {
      setTimeout(() => {
        startUdeciaTour(roadmapTourSteps);
        localStorage.setItem('udeciaHomeTourDone', 'true');
        if (urlParams.has('tour')) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      }, 500);
    }
  });
</script>

<%- include('../partials/footer') %>
