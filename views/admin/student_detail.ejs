<%- include('../partials/admin-header') %>

<div style="max-width: 1200px; margin: 0 auto; padding: 1.5rem;">

  <!-- Back button + Header -->
  <div style="display:flex; align-items:center; gap:1rem; margin-bottom:2rem; flex-wrap:wrap;">
    <a href="/admin/dashboard" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:var(--text-primary); text-decoration:none; padding:0.5rem 1rem; border-radius:8px; font-size:0.9rem;">← Volver al Dashboard</a>
    <h1 style="margin:0; font-size:1.8rem;">📋 Perfil de Estudiante</h1>
  </div>

  <!-- Student Header Card -->
  <div style="background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(6,182,212,0.15)); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:2rem; margin-bottom:2rem; display:flex; gap:2rem; align-items:center; flex-wrap:wrap;">
    <div style="font-size:4rem; background:rgba(255,255,255,0.05); width:90px; height:90px; border-radius:50%; display:flex; align-items:center; justify-content:center; border:2px solid var(--accent-cyan); flex-shrink:0;">🧑‍🎓</div>
    <div style="flex:1;">
      <h2 style="margin:0 0 0.25rem; font-size:2rem;"><%= student.FirstName %> <%= student.LastName %></h2>
      <p style="margin:0; color:var(--text-secondary);"><%= student.Email %></p>
      <p style="margin:0.5rem 0 0; font-size:0.85rem; color:var(--accent-cyan);">Miembro desde: <%= new Date(student.CreatedAt).toLocaleDateString('es-CO') %></p>
    </div>
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <div style="text-align:center; background:rgba(255,255,255,0.03); padding:1rem 1.5rem; border-radius:12px; border:1px solid rgba(255,255,255,0.05);">
        <div style="font-size:1.8rem; font-weight:800; color:var(--accent-cyan);"><%= student.TotalXP %></div>
        <div style="font-size:0.8rem; color:var(--text-secondary);">XP Total</div>
      </div>
      <div style="text-align:center; background:rgba(255,255,255,0.03); padding:1rem 1.5rem; border-radius:12px; border:1px solid rgba(255,255,255,0.05);">
        <div style="font-size:1.8rem; font-weight:800; color:var(--accent-gold);">Nv. <%= student.Level %></div>
        <div style="font-size:0.8rem; color:var(--text-secondary);">Nivel</div>
      </div>
      <div style="text-align:center; background:rgba(255,255,255,0.03); padding:1rem 1.5rem; border-radius:12px; border:1px solid rgba(255,255,255,0.05);">
        <div style="font-size:1.8rem; font-weight:800; color:#f97316;">🔥 <%= student.CurrentStreak %></div>
        <div style="font-size:0.8rem; color:var(--text-secondary);">Días de Racha</div>
      </div>
    </div>
  </div>

  <!-- Pre-Test Scores -->
  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1.5rem; margin-bottom:2rem;">
    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:1.5rem;">
      <h3 style="margin:0 0 1rem; color:var(--accent-cyan);">📝 Resultado Pre-Test</h3>
      <% if (preTest) { %>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
          <% const competencies = [
            { label: 'Total', value: Math.round(preTest.TotalScore || 0), color: '#7c3aed' },
            { label: 'Vocabulario', value: Math.round(preTest.VocabularyScore || 0), color: '#06b6d4' },
            { label: 'Lectura', value: Math.round(preTest.ReadingScore || 0), color: '#10b981' },
            { label: 'Pragmática', value: Math.round(preTest.PragmaticsScore || 0), color: '#f59e0b' },
            { label: 'Gramática', value: Math.round(preTest.GrammarScore || 0), color: '#ec4899' }
          ]; %>
          <% competencies.forEach(c => { %>
            <div style="background:rgba(255,255,255,0.02); border-radius:8px; padding:0.75rem; border-left:3px solid <%= c.color %>;">
              <div style="font-size:0.75rem; color:var(--text-secondary); margin-bottom:0.25rem;"><%= c.label %></div>
              <div style="font-size:1.4rem; font-weight:700; color:<%= c.color %>;"><%= c.value %>%</div>
              <div style="background:rgba(255,255,255,0.05); border-radius:4px; height:4px; margin-top:0.5rem;">
                <div style="background:<%= c.color %>; border-radius:4px; height:4px; width:<%= c.value %>%;"></div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="color:var(--text-secondary);">⚠️ El estudiante aún no ha completado el Pre-Test.</p>
      <% } %>
    </div>

    <!-- Radar Chart for Competency Progress -->
    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:1.5rem; display:flex; flex-direction:column; align-items:center;">
      <h3 style="margin:0 0 1rem; color:var(--accent-cyan); align-self:flex-start;">🕸️ Perfil de Competencias (Módulos)</h3>
      <canvas id="competencyRadar" style="max-width:280px;"></canvas>
    </div>
  </div>

  <!-- ML Models Section -->
  <h2 style="margin:0 0 1rem; color:var(--accent-gold); display:flex; align-items:center; gap:0.5rem;">🤖 Predicciones de Machine Learning</h2>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:2rem;">

    <!-- Model 1: Linear Regression -->
    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(124,58,237,0.3); border-radius:12px; padding:1.5rem;">
      <h3 style="margin:0 0 0.5rem; color:#7c3aed; display:flex; align-items:center; gap:0.5rem;">📈 Regresión Lineal</h3>
      <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:1rem;">Proyección del puntaje final en el Post-Test basado en la tendencia histórica de calificaciones.</p>
      <div style="background:rgba(124,58,237,0.1); border-radius:10px; padding:1rem; margin-bottom:1rem; text-align:center;">
        <span style="font-size:3rem; font-weight:800; color:#7c3aed;"><%= linearResult.projectedScore %>%</span>
        <p style="margin:0.25rem 0 0; color:var(--text-secondary); font-size:0.85rem;">Puntaje Proyectado en Post-Test</p>
      </div>
      <div style="display:flex; gap:1rem; margin-bottom:1rem;">
        <div style="flex:1; text-align:center; background:rgba(255,255,255,0.03); border-radius:8px; padding:0.75rem;">
          <div style="font-size:1.2rem; font-weight:700; color:#a78bfa;"><%= linearResult.slope > 0 ? '+' : '' %><%= linearResult.slope %></div>
          <div style="font-size:0.75rem; color:var(--text-secondary);">Pendiente (Velocidad de Aprendizaje)</div>
        </div>
        <div style="flex:1; text-align:center; background:rgba(255,255,255,0.03); border-radius:8px; padding:0.75rem;">
          <div style="font-size:1.2rem; font-weight:700; color:#a78bfa;">R²: <%= linearResult.r2 %></div>
          <div style="font-size:0.75rem; color:var(--text-secondary);">Ajuste del Modelo</div>
        </div>
      </div>
      <% if (linearResult.slope > 1) { %>
        <p style="color:#10b981; font-size:0.85rem; margin:0;">✅ Tendencia <strong>positiva</strong>: el estudiante está mejorando consistentemente.</p>
      <% } else if (linearResult.slope >= 0) { %>
        <p style="color:#f59e0b; font-size:0.85rem; margin:0;">⚠️ Tendencia <strong>estable</strong>: el progreso es lento pero constante.</p>
      <% } else { %>
        <p style="color:#ef4444; font-size:0.85rem; margin:0;">🚨 Tendencia <strong>negativa</strong>: el rendimiento está bajando. Requiere atención.</p>
      <% } %>
      <div class="chart-container" style="margin-top:1rem; height:150px;"><canvas id="trendChart"></canvas></div>
    </div>

    <!-- Model 2: Logistic Regression -->
    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(6,182,212,0.3); border-radius:12px; padding:1.5rem;">
      <h3 style="margin:0 0 0.5rem; color:#06b6d4; display:flex; align-items:center; gap:0.5rem;">📊 Regresión Logística</h3>
      <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:1rem;">Probabilidad de que el estudiante apruebe la prueba Saber Pro (umbral de éxito: 60%).</p>
      
      <div style="text-align:center; margin-bottom:1rem;">
        <div style="position:relative; display:inline-block; width:120px; height:120px;">
          <svg viewBox="0 0 120 120" style="transform:rotate(-90deg); width:120px; height:120px;">
            <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="12"/>
            <circle cx="60" cy="60" r="50" fill="none" 
              stroke="<%= logisticResult.probability >= 60 ? '#10b981' : logisticResult.probability >= 40 ? '#f59e0b' : '#ef4444' %>" 
              stroke-width="12"
              stroke-dasharray="<%= Math.round(logisticResult.probability * 3.14) %> 314"
              stroke-linecap="round"/>
          </svg>
          <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center;">
            <div style="font-size:1.6rem; font-weight:800; color:<%= logisticResult.probability >= 60 ? '#10b981' : logisticResult.probability >= 40 ? '#f59e0b' : '#ef4444' %>;"><%= logisticResult.probability %>%</div>
          </div>
        </div>
        <p style="margin:0.5rem 0 0; font-weight:600; color:<%= logisticResult.probability >= 60 ? '#10b981' : logisticResult.probability >= 40 ? '#f59e0b' : '#ef4444' %>;">
          <%= logisticResult.classification %>
        </p>
      </div>
      
      <p style="font-size:0.85rem; margin:0 0 0.75rem; color:var(--text-primary);"><%= logisticResult.recommendation %></p>
      
      <% if (logisticResult.riskFactors.length > 0) { %>
        <h4 style="margin:0 0 0.5rem; font-size:0.85rem; color:#ef4444;">⚠️ Factores de Riesgo:</h4>
        <ul style="margin:0; padding-left:1.25rem; font-size:0.8rem; color:var(--text-secondary);">
          <% logisticResult.riskFactors.forEach(rf => { %>
            <li><%= rf.factor %> <span style="color:#ef4444; font-size:0.75rem;">(Impacto: <%= rf.impact %>)</span></li>
          <% }); %>
        </ul>
      <% } else { %>
        <p style="color:#10b981; font-size:0.85rem; margin:0;">✅ No se detectaron factores de riesgo significativos.</p>
      <% } %>
    </div>
  </div>

  <!-- K-Means Cluster Badge -->
  <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:1.5rem; margin-bottom:2rem; display:flex; gap:2rem; align-items:center; flex-wrap:wrap;">
    <div>
      <h3 style="margin:0 0 0.25rem; color:var(--accent-gold);">🤖 Clasificación K-Means</h3>
      <p style="margin:0; font-size:0.85rem; color:var(--text-secondary);">Grupo asignado automáticamente según el rendimiento comparado con todos los estudiantes.</p>
    </div>
    <div style="background:<%= clusterInfo.clusterColor %>22; border:2px solid <%= clusterInfo.clusterColor %>; border-radius:12px; padding:1rem 2rem; text-align:center;">
      <div style="font-size:2rem; font-weight:800; color:<%= clusterInfo.clusterColor %>;"><%= clusterInfo.clusterName %></div>
    </div>
  </div>

  <!-- Weekly Progress Table -->
  <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:1.5rem;">
    <h3 style="margin:0 0 1rem; color:var(--accent-cyan);">📅 Progreso Semana a Semana</h3>
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
            <th style="text-align:left; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Semana</th>
            <th style="text-align:left; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Título</th>
            <th style="text-align:center; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Progreso</th>
            <th style="text-align:center; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Puntaje Prom.</th>
            <th style="text-align:center; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Tiempo Total</th>
            <th style="text-align:center; padding:0.75rem; color:var(--text-secondary); font-weight:600;">Intentos Prom.</th>
          </tr>
        </thead>
        <tbody>
          <% weeklyProgress.forEach(w => { 
            const progress = w.TotalActivities > 0 ? Math.round((w.CompletedActivities / w.TotalActivities) * 100) : 0;
            const minutes = Math.round((w.TotalTime || 0) / 60);
            const avgAttempts = w.AvgAttempts ? parseFloat(w.AvgAttempts).toFixed(1) : '—';
            const avgScore = w.AvgScore ? Math.round(parseFloat(w.AvgScore)) : null;
          %>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04); transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
              <td style="padding:0.75rem; font-weight:600;">Sem. <%= w.WeekNumber %></td>
              <td style="padding:0.75rem; color:var(--text-secondary); font-size:0.85rem;"><%= w.Title %></td>
              <td style="padding:0.75rem; text-align:center;">
                <div style="display:flex; align-items:center; gap:0.5rem; justify-content:center;">
                  <div style="background:rgba(255,255,255,0.05); border-radius:4px; height:8px; width:80px; overflow:hidden;">
                    <div style="background:<%= progress === 100 ? '#10b981' : '#06b6d4' %>; height:8px; width:<%= progress %>%; border-radius:4px;"></div>
                  </div>
                  <span style="font-size:0.8rem; color:<%= progress === 100 ? '#10b981' : 'var(--text-secondary)' %>;"><%= progress %>%</span>
                </div>
              </td>
              <td style="padding:0.75rem; text-align:center; font-weight:700; color:<%= avgScore !== null ? (avgScore >= 70 ? '#10b981' : avgScore >= 50 ? '#f59e0b' : '#ef4444') : 'var(--text-secondary)' %>;">
                <%= avgScore !== null ? avgScore + '%' : '—' %>
              </td>
              <td style="padding:0.75rem; text-align:center; color:var(--text-secondary);"><%= minutes > 0 ? minutes + ' min' : '—' %></td>
              <td style="padding:0.75rem; text-align:center; color:<%= parseFloat(avgAttempts) > 2 ? '#ef4444' : 'var(--text-secondary)' %>;"><%= avgAttempts %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {

    // Competency Radar Chart
    const compData = <%- JSON.stringify(competencyProgress) %>;
    const typeMap = { Vocabulary: 'Vocabulario', Reading: 'Lectura', Pragmatics: 'Pragmática', Grammar: 'Gramática' };
    const radarLabels = ['Vocabulario', 'Lectura', 'Pragmática', 'Gramática'];
    const typeKeys = ['Vocabulary', 'Reading', 'Pragmatics', 'Grammar'];
    const radarValues = typeKeys.map(k => {
        const found = compData.find(c => c.TypeName === k);
        return found ? Math.round(parseFloat(found.AvgScore)) : 0;
    });

    new Chart(document.getElementById('competencyRadar').getContext('2d'), {
        type: 'radar',
        data: {
            labels: radarLabels,
            datasets: [{
                label: 'Desempeño (%)',
                data: radarValues,
                backgroundColor: 'rgba(6,182,212,0.15)',
                borderColor: 'rgba(6,182,212,1)',
                pointBackgroundColor: '#7c3aed',
                pointBorderColor: '#fff',
            }]
        },
        options: {
            scales: {
                r: {
                    angleLines: { color: 'rgba(255,255,255,0.08)' },
                    grid: { color: 'rgba(255,255,255,0.08)' },
                    pointLabels: { color: '#94a3b8', font: { size: 12 } },
                    ticks: { display: false, min: 0, max: 100 },
                    suggestedMin: 0, suggestedMax: 100
                }
            },
            plugins: { legend: { display: false } }
        }
    });

    // Trend Line Chart (Linear Regression)
    const trendLine = <%- JSON.stringify(linearResult.trendLine || []) %>;
    const weeklyScores = <%- JSON.stringify(weeklyProgress.filter(w => w.AvgScore !== null).map(w => ({ x: w.WeekNumber, y: Math.round(parseFloat(w.AvgScore)) }))) %>;

    if (trendLine.length > 0) {
        new Chart(document.getElementById('trendChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: Array.from({ length: 12 }, (_, i) => `S${i + 1}`),
                datasets: [
                    {
                        label: 'Puntajes Reales',
                        data: Array.from({ length: 12 }, (_, i) => {
                            const found = weeklyScores.find(w => w.x === i + 1);
                            return found ? found.y : null;
                        }),
                        borderColor: '#06b6d4',
                        backgroundColor: 'rgba(6,182,212,0.1)',
                        pointRadius: 5,
                        spanGaps: false
                    },
                    {
                        label: 'Tendencia ML',
                        data: trendLine.map(p => p.y),
                        borderColor: '#f59e0b',
                        borderDash: [5, 5],
                        borderWidth: 2,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#94a3b8', font: { size: 10 } } } },
                scales: {
                    x: { ticks: { color: '#94a3b8', font: { size: 9 } }, grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: { min: 0, max: 100, ticks: { color: '#94a3b8', font: { size: 9 }, callback: v => v + '%' }, grid: { color: 'rgba(255,255,255,0.05)' } }
                }
            }
        });
    }
});
</script>

<%- include('../partials/admin-footer') %>
