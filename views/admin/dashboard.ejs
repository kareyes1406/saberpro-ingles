<%- include('../partials/admin-header') %>

<!-- Page Header -->
<div id="pdf-content" style="padding: 10px;">
<div class="page-header">
  <h1>📊 Dashboard Analítico</h1>
  <p style="color:var(--text-secondary)">Bienvenido, <%= user.FirstName %> — Vista de Analítica Avanzada + Modelos ML</p>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Estudiantes Activos</h3>
      <div class="kpi-value" id="totalUsers"><%= kpis.totalUsers %></div>
    </div>
    <div class="kpi-icon">👥</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Finalización</h3>
      <div class="kpi-value" id="completionRate"><%= kpis.completionRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(16,185,129,0.1);color:var(--color-success);">✅</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tasa de Abandono</h3>
      <div class="kpi-value" style="color:var(--color-error);" id="abandonRate"><%= kpis.abandonRate %>%</div>
    </div>
    <div class="kpi-icon" style="background:rgba(239,68,68,0.1);color:var(--color-error);">⚠️</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-info">
      <h3>Tiempo Promedio / Evaluación</h3>
      <div class="kpi-value" id="avgTime"><%= kpis.avgTimeMinutes %> min</div>
    </div>
    <div class="kpi-icon" style="background:rgba(245,158,11,0.1);color:var(--color-gold);">⏱️</div>
  </div>
  <div class="kpi-card" style="border-color:<%= (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) ? 'rgba(239,68,68,0.4)' : 'rgba(255,255,255,0.05)' %>;">
    <div class="kpi-info">
      <h3>Mensajes Sin Leer</h3>
      <div class="kpi-value" style="color:<%= (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) ? '#ef4444' : '#10b981' %>;"><%= typeof unreadMessagesCount !== 'undefined' ? unreadMessagesCount : 0 %></div>
    </div>
    <div class="kpi-icon" style="background:rgba(6,182,212,0.1);color:var(--accent-cyan);">💬</div>
  </div>
</div>

<!-- Mensajes Recientes Section -->
<div style="background: var(--bg-card); border: 1px solid <%= (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) ? 'rgba(239,68,68,0.4)' : 'rgba(255,255,255,0.06)' %>; border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: var(--space-xl); box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <span style="font-size:1.4rem;">💬</span>
      <h3 style="margin:0; font-size:1.1rem; color:#fff;">Mensajes Recientes de Estudiantes</h3>
      <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
        <span style="background:rgba(239,68,68,0.2); color:#ef4444; border:1px solid #ef4444; padding:2px 8px; border-radius:12px; font-size:0.75rem; font-weight:700;">
          <%= unreadMessagesCount %> pendiente<%= unreadMessagesCount > 1 ? 's' : '' %>
        </span>
      <% } %>
    </div>
    <a href="/messages/admin" style="background:var(--accent-purple); color:white; text-decoration:none; padding:0.35rem 0.85rem; border-radius:6px; font-size:0.85rem; font-weight:600; display:inline-flex; align-items:center; gap:0.4rem;">
      Ver Todos los Mensajes →
    </a>
  </div>

  <% if (typeof recentMessages !== 'undefined' && recentMessages.length > 0) { %>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      <% recentMessages.forEach(msg => { %>
        <div style="background:rgba(0,0,0,0.25); border-radius:8px; padding:0.85rem 1rem; border-left:3px solid <%= msg.IsRead ? '#64748b' : '#ef4444' %>; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
          <div style="flex:1; min-width:240px;">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <strong style="color:#f8fafc; font-size:0.95rem;"><%= msg.SenderName || 'Estudiante' %></strong>
              <span style="color:#94a3b8; font-size:0.8rem;"><%= new Date(msg.CreatedAt).toLocaleString('es-CO') %></span>
              <% if (!msg.IsRead) { %>
                <span style="background:rgba(239,68,68,0.2); color:#ef4444; font-size:0.7rem; font-weight:700; padding:1px 6px; border-radius:6px;">NUEVO</span>
              <% } %>
            </div>
            <p style="margin:0.25rem 0 0; color:#cbd5e1; font-size:0.88rem; line-height:1.4;">
              <%= msg.MessageText.length > 120 ? msg.MessageText.substring(0, 120) + '...' : msg.MessageText %>
            </p>
          </div>
          <div>
            <a href="/messages/admin" style="background:rgba(6,182,212,0.15); color:var(--accent-cyan); text-decoration:none; padding:0.35rem 0.75rem; border-radius:6px; font-size:0.8rem; font-weight:600;">
              Responder
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p style="margin:0; color:var(--text-secondary); font-size:0.9rem;">
      No hay mensajes pendientes por responder. ¡Todo al día! ✨
    </p>
  <% } %>
</div>

<!-- ORIGINAL Charts Row 1 -->
<div class="charts-grid" id="charts-section">
  <div class="chart-card">
    <h3>Tasa de Finalización por Semana</h3>
    <div class="chart-container"><canvas id="completionChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Tiempo Promedio por Evaluación (seg)</h3>
    <div class="chart-container"><canvas id="timeChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Efectividad por Módulo</h3>
    <div class="chart-container"><canvas id="effectivenessChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Actividad Últimos 7 Días</h3>
    <div class="chart-container"><canvas id="activityChart"></canvas></div>
  </div>
</div>

<!-- NEW Charts Row 2 -->
<h2 style="margin: 2rem 0 1rem; font-size: 1.3rem; color: var(--accent-cyan); display:flex; align-items:center; gap:0.5rem;">🔬 Analítica Avanzada</h2>
<div class="charts-grid">
  <div class="chart-card">
    <h3>Pre-Test vs Módulos — Comparativo de Competencias</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Promedio grupal: Puntaje Pre-Test vs Desempeño en Módulos</p>
    <div class="chart-container"><canvas id="preVsModuleChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>Distribución de Niveles de Jugador</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Cuántos estudiantes hay en cada nivel de XP</p>
    <div class="chart-container"><canvas id="levelDistChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🏆 Top 10 Estudiantes por XP</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Ranking de los mejores estudiantes</p>
    <div class="chart-container"><canvas id="topStudentsChart"></canvas></div>
  </div>
  <div class="chart-card">
    <h3>🤖 K-Means Clustering — Grupos de Rendimiento</h3>
    <p style="font-size:0.8rem; color:var(--text-secondary); margin-top:-0.5rem; margin-bottom:0.5rem;">Clasificación automática de estudiantes por rendimiento</p>
    <div class="chart-container"><canvas id="clusterChart"></canvas></div>
    <div id="clusterLegend" style="margin-top:0.75rem;"></div>
  </div>
</div>

<!-- Users Table -->
<div class="table-container" id="users-section">
  <div class="table-header-actions">
    <h2>Gestión de Estudiantes</h2>
    <div style="display:flex;gap:0.5rem;align-items:center;">
      <input type="text" id="searchUsers" placeholder="🔍 Buscar..." class="form-control" style="width:200px;">
      <button onclick="openCreateModal()" class="btn-primary">+ Agregar Estudiante</button>
      <button onclick="exportToCSV()" class="btn-secondary" style="background:#06b6d4; color:white; border:none;">📥 CSV</button>
      <button onclick="exportDashboardPDF()" class="btn-secondary" style="background:#ef4444; color:white; border:none;">📄 PDF Informe</button>
    </div>
  </div>
  <div class="accordion-list" id="usersList">
    <% users.forEach(user => { %>
      <details class="user-accordion" data-user-id="<%= user.UserID %>">
        <summary class="user-summary">
          <div class="user-main-info">
            <strong><%= user.FirstName %> <%= user.LastName %></strong>
            <span class="badge-pill <%= user.IsActive ? 'active' : 'inactive' %>">
              <%= user.IsActive ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
          <div class="user-sub-info">
            <small><%= user.Email %></small>
            <small>Semana <%= user.CurrentWeek || 1 %> - <%= user.CurrentActivity || 'Sin actividad' %></small>
          </div>
        </summary>
        <div class="user-details-content">
          <div class="user-stats">
            <div><strong>ID:</strong> <%= user.UserID %></div>
            <div><strong>XP Total:</strong> <%= user.TotalXP %> XP</div>
            <div><strong>Racha:</strong> 🔥 <%= user.CurrentStreak %> días</div>
          </div>
          <div class="action-btns">
            <a href="/admin/students/<%= user.UserID %>/detail" class="btn-icon" title="Ver Progreso Detallado" style="background:rgba(6,182,212,0.15); color:var(--accent-cyan); text-decoration:none; border-radius:6px; padding:0.4rem 0.5rem; display:inline-flex; align-items:center; justify-content:center;">👁️ Progreso</a>
            <button class="btn-icon edit" 
                    data-user-id="<%= user.UserID %>"
                    data-first-name="<%= user.FirstName %>"
                    data-last-name="<%= user.LastName %>"
                    data-email="<%= user.Email %>"
                    data-is-active="<%= user.IsActive ? '1' : '0' %>"
                    onclick="openEditModal({
                      UserID: this.dataset.userId,
                      FirstName: this.dataset.firstName,
                      LastName: this.dataset.lastName,
                      Email: this.dataset.email,
                      IsActive: this.dataset.isActive === '1'
                    })"
                    style="display:inline-flex; align-items:center; justify-content:center; gap:5px;">✏️ Editar</button>
            <button class="btn-icon delete" onclick="deleteUser('<%= user.UserID %>')" style="display:inline-flex; align-items:center; justify-content:center; gap:5px;">🗑️ Eliminar</button>
          </div>
        </div>
      </details>
    <% }); %>
  </div>
</div>
</div> <!-- End pdf-content -->

<!-- Official PDF Report Template (Hidden) -->
<div id="official-report-template" style="display:none; background:white; color:black; font-family:Arial, sans-serif; padding:40px; width:800px;">
  <!-- Header -->
  <div style="text-align:center; border-bottom:2px solid #333; padding-bottom:20px; margin-bottom:30px;">
    <h1 style="margin:0; font-size:24px; color:#333;">INFORME DE RENDIMIENTO ACADÉMICO</h1>
    <h2 style="margin:5px 0 0; font-size:18px; color:#555;">Plataforma SaberPro Inglés</h2>
    <p style="margin:10px 0 0; font-size:14px; color:#777;" id="report-date"></p>
  </div>

  <!-- Summary Section -->
  <div style="margin-bottom:30px;">
    <h3 style="border-left:4px solid #7c3aed; padding-left:10px; font-size:18px; color:#333;">1. Resumen Ejecutivo</h3>
    <p style="font-size:14px; line-height:1.6; color:#444;">
      El presente informe detalla el progreso general de los estudiantes en la plataforma de preparación SaberPro Inglés.
      Actualmente, la plataforma cuenta con <strong id="rep-total-users"></strong> estudiantes activos.
    </p>
    <table style="width:100%; border-collapse:collapse; margin-top:15px; font-size:14px;">
      <tr>
        <td style="padding:10px; border:1px solid #ddd; background:#f9f9f9; font-weight:bold; width:50%;">Tasa de Finalización de Módulos:</td>
        <td style="padding:10px; border:1px solid #ddd;" id="rep-completion"></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd; background:#f9f9f9; font-weight:bold;">Tasa de Abandono (Inactividad > 7 días):</td>
        <td style="padding:10px; border:1px solid #ddd;" id="rep-abandon"></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd; background:#f9f9f9; font-weight:bold;">Tiempo Promedio por Evaluación:</td>
        <td style="padding:10px; border:1px solid #ddd;" id="rep-time"></td>
      </tr>
    </table>
  </div>

  <!-- Charts Section -->
  <div style="margin-bottom:30px;">
    <h3 style="border-left:4px solid #06b6d4; padding-left:10px; font-size:18px; color:#333;">2. Análisis de Competencias (Pre-Test vs Actual)</h3>
    <p style="font-size:14px; line-height:1.6; color:#444; margin-bottom:15px;">
      La siguiente gráfica muestra el comparativo entre el nivel diagnóstico inicial de los estudiantes y su desempeño actual promedio en los módulos de la plataforma, evidenciando la evolución en cada competencia evaluada.
    </p>
    <div style="text-align:center;">
      <img id="rep-chart-competencies" src="" style="max-width:100%; height:auto; border:1px solid #eee; padding:10px;">
    </div>
  </div>

  <div class="html2pdf__page-break"></div> <!-- Salto de página para PDF -->

  <div style="margin-bottom:30px;">
    <h3 style="border-left:4px solid #f59e0b; padding-left:10px; font-size:18px; color:#333;">3. Clasificación K-Means (Inteligencia Artificial)</h3>
    <p style="font-size:14px; line-height:1.6; color:#444; margin-bottom:15px;">
      El algoritmo de Machine Learning ha clasificado automáticamente a los estudiantes en grupos de rendimiento basándose en su XP total, calificaciones y constancia. Esto permite identificar rápidamente a la población en riesgo.
    </p>
    <div style="text-align:center;">
      <img id="rep-chart-kmeans" src="" style="max-width:80%; height:auto; border:1px solid #eee; padding:10px;">
    </div>
  </div>

  <div style="margin-bottom:30px;">
    <h3 style="border-left:4px solid #10b981; padding-left:10px; font-size:18px; color:#333;">4. Histórico de Efectividad y Retención</h3>
    <p style="font-size:14px; line-height:1.6; color:#444; margin-bottom:15px;">
      Evolución de la tasa de completitud semana a semana a lo largo del programa.
    </p>
    <div style="text-align:center;">
      <img id="rep-chart-completion" src="" style="max-width:100%; height:auto; border:1px solid #eee; padding:10px;">
    </div>
  </div>

  <!-- Footer -->
  <div style="text-align:center; border-top:1px solid #ddd; padding-top:15px; margin-top:40px; font-size:12px; color:#888;">
    Documento autogenerado por Inteligencia Artificial - SaberPro Inglés
  </div>
</div>

<!-- CRUD Modal -->
<div class="modal-overlay" id="userModal" data-html2canvas-ignore="true">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modalTitle">Agregar Estudiante</h3>
      <button class="close-btn" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
      <form id="userForm">
        <input type="hidden" id="formUserId">
        <div class="form-group">
          <label class="form-label">Nombre</label>
          <input type="text" id="formFirstName" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">Apellido</label>
          <input type="text" id="formLastName" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" id="formEmail" class="form-control" required>
        </div>
        <div class="form-group" id="passwordGroup">
          <label class="form-label">Contraseña</label>
          <input type="password" id="formPassword" class="form-control">
        </div>
        <div class="form-group" id="roleGroup">
          <label class="form-label">Rol de Usuario</label>
          <select id="formRole" class="form-control">
            <option value="student">Estudiante</option>
            <option value="professor">Profesor (Solo Lectura Estadísticas)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select id="formActive" class="form-control">
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
          </select>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button type="button" onclick="closeModal()" class="btn btn-secondary">Cancelar</button>
      <button type="button" onclick="submitUserForm()" class="btn btn-primary">Guardar</button>
    </div>
  </div>
</div>




<style>
/* 
 * Optimizaciones para la exportación a PDF (html2pdf)
 * Se aplican temporalmente mediante la clase .pdf-export-mode
 */
.pdf-export-mode {
    background-color: #0f1628 !important; /* Fondo limpio y oscuro estándar */
    color: #f8fafc !important;
    padding: 20px 40px !important;
}

/* Evitar que las gráficas y tarjetas se corten entre páginas */
.pdf-export-mode .chart-card, 
.pdf-export-mode .kpi-card, 
.pdf-export-mode .table-container {
    page-break-inside: avoid;
    break-inside: avoid;
    border: 1px solid rgba(255,255,255,0.15) !important;
    box-shadow: none !important;
    margin-bottom: 20px;
}

/* Forzar fondos para que html2canvas los pinte (algunos navegadores ignoran background-colors transparentes en lienzo) */
.pdf-export-mode .kpi-card {
    background-color: rgba(255,255,255,0.03) !important;
}
.pdf-export-mode .chart-card {
    background-color: rgba(255,255,255,0.03) !important;
}

/* Asegurar que las cuadrículas mantengan su forma (gracias a windowWidth 1280) */
.pdf-export-mode .kpi-grid {
    gap: 15px !important;
    margin-bottom: 30px !important;
}

.pdf-export-mode .charts-grid {
    gap: 20px !important;
    margin-bottom: 30px !important;
}

/* Ocultar elementos interactivos y botones de acción que no sirven en el PDF */
.pdf-export-mode .table-header-actions button,
.pdf-export-mode .table-header-actions input {
    display: none !important;
}

/* Ocultar la columna de acciones en la tabla */
.pdf-export-mode #usersTable th:last-child,
.pdf-export-mode #usersTable td:last-child {
    display: none !important;
}

.pdf-export-mode #usersTable th, 
.pdf-export-mode #usersTable td {
    padding: 10px !important;
    font-size: 0.85rem !important;
}

/* Asegurar que el scroll no afecte la tabla */
.pdf-export-mode .table-container {
    overflow: visible !important;
}

/* Agregar un pie de página o marca de agua en modo PDF */
.pdf-export-mode::after {
    content: "Reporte generado por SaberPro Inteligencia Artificial - Uso Oficial";
    display: block;
    text-align: center;
    color: rgba(255,255,255,0.3);
    font-size: 0.8rem;
    margin-top: 40px;
    page-break-inside: avoid;
}

/* Accordion Styles for Users List */
.accordion-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
}

.user-accordion {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.user-accordion[open] {
  background: rgba(255,255,255,0.05);
  border-color: var(--accent-cyan);
}

.user-summary {
  padding: 15px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  list-style: none; /* Hide default arrow */
}

.user-summary::-webkit-details-marker {
  display: none;
}

.user-summary:hover {
  background: rgba(255,255,255,0.05);
}

.user-main-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 1.1rem;
}

.user-sub-info {
  display: flex;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.user-details-content {
  padding: 15px;
  border-top: 1px solid rgba(255,255,255,0.1);
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.user-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
  background: rgba(0,0,0,0.2);
  padding: 10px;
  border-radius: 6px;
}

.user-details-content .action-btns {
  justify-content: flex-start;
  gap: 10px;
}

@media (max-width: 600px) {
  .user-sub-info {
    flex-direction: column;
    gap: 2px;
  }
}
</style>

<%- include('../partials/admin-footer') %>
