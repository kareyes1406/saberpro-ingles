<!DOCTYPE html>
<html lang="es" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <meta name="description" content="SaberPro Inglés - Plataforma gamificada de preparación para pruebas Saber Pro">
    <title><%= typeof title !== 'undefined' ? title : 'SaberPro' %> | SaberPro Inglés</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <% if (typeof cssFile !== 'undefined' && cssFile) { %>
        <link rel="stylesheet" href="/css/<%= cssFile %>">
    <% } %>
</head>
<body>
    <!-- Glassmorphism Navbar -->
    <nav class="navbar">
        <div style="display:flex; align-items:center; gap: 1.5rem;">
            <a href="/student" class="navbar-brand">
                🎓 <span>SaberPro</span> Inglés
            </a>
            <% if (typeof user !== 'undefined' && user) { %>
            <a href="/student" style="color:var(--text-primary); text-decoration:none; font-weight:500; padding:0.4rem 0.8rem; background:rgba(255,255,255,0.05); border-radius:6px; transition:all 0.2s; border:1px solid rgba(255,255,255,0.1);">🏠 Inicio</a>
            <% } %>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-stats">
            <div class="xp-bar-container">
                <div class="xp-bar" id="navXPBar" <%- `style="width: ${typeof studentStats !== 'undefined' ? (studentStats.TotalXP % 100) : 0}%;"` %>></div>
                <span class="xp-text">Nv. <%= typeof studentStats !== 'undefined' ? studentStats.Level : 1 %> — <%= typeof studentStats !== 'undefined' ? studentStats.TotalXP : 0 %> XP</span>
            </div>
            <div class="streak-counter">
                🔥 <span id="navStreak"><%= typeof studentStats !== 'undefined' ? studentStats.CurrentStreak : 0 %></span>
            </div>
            <div class="coin-counter">
                🪙 <span id="navCoins"><%= typeof studentStats !== 'undefined' ? studentStats.TotalCoins : 0 %></span>
            </div>
        </div>
        <div class="nav-user" style="position: relative;">
            <button onclick="document.getElementById('userDropdown').style.display = document.getElementById('userDropdown').style.display === 'none' ? 'block' : 'none';" style="background:rgba(6, 182, 212, 0.1); border:1px solid var(--accent-cyan); color:var(--accent-cyan); font-weight:600; cursor:pointer; font-size:1rem; display:flex; align-items:center; gap:0.5rem; padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;">
                <%= user.FirstName %> 👤 <span>▼</span>
            </button>
            <div id="userDropdown" style="display:none; position:absolute; right:0; top:120%; background:var(--bg-surface); border:1px solid rgba(255,255,255,0.1); border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.6); padding:0.5rem; min-width:160px; z-index:1000;">
                <a href="/student/profile" style="display:block; padding:0.6rem 1rem; color:var(--text-primary); text-decoration:none; border-radius:4px; margin-bottom:0.25rem; font-weight:500;">✏️ Mi Perfil</a>
                <hr style="border:0; border-top:1px solid rgba(255,255,255,0.1); margin:0.25rem 0;">
                <form action="/auth/logout" method="POST" style="margin:0;">
                    <button type="submit" style="width:100%; text-align:left; background:transparent; border:none; color:var(--error-color); padding:0.6rem 1rem; border-radius:4px; cursor:pointer; font-weight:500; font-size:1rem;">🚪 Cerrar Sesión</button>
                </form>
            </div>
        </div>
        <script>
            // Cerrar el menú si se hace clic afuera
            document.addEventListener('click', function(event) {
                const userNav = document.querySelector('.nav-user');
                const dropdown = document.getElementById('userDropdown');
                if (userNav && dropdown && !userNav.contains(event.target)) {
                    dropdown.style.display = 'none';
                }
            });
        </script>
        <% } %>
    </nav>
    
    <!-- Flash Messages -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <% error.forEach(msg => { %>
            <div class="flash-message flash-error">⚠️ <%= msg %></div>
        <% }); %>
    <% } %>
    <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <% success_msg.forEach(msg => { %>
            <div class="flash-message flash-success">✅ <%= msg %></div>
        <% }); %>
    <% } %>
    
    <main>
