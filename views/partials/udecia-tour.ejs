<!-- Custom UDECIA Interactive Tour -->
<style>
  #udecia-tour-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(15, 23, 42, 0.85);
    /* Se quitó el backdrop-filter blur para evitar problemas de contextos de apilamiento borrosos */
    z-index: 9998;
  }
  #udecia-tour-dialog {
    display: none;
    position: fixed;
    bottom: 30px; left: 50%;
    transform: translateX(-50%);
    width: 90%; max-width: 600px;
    background: var(--bg-card);
    border: 2px solid var(--accent-cyan);
    border-radius: 16px;
    z-index: 10000;
    padding: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.9), 0 0 20px rgba(6, 182, 212, 0.4);
    align-items: center;
    gap: 20px;
    animation: slideUpTour 0.4s ease-out;
  }
  @keyframes slideUpTour {
    from { bottom: -100px; opacity: 0; }
    to { bottom: 30px; opacity: 1; }
  }
  .tour-highlighted-element {
    position: relative !important;
    z-index: 9999 !important;
    box-shadow: 0 0 0 4px var(--accent-cyan), 0 0 20px var(--accent-cyan) !important;
    background: var(--bg-card) !important;
    border-radius: 8px !important;
    transition: all 0.3s;
  }
  .tour-elevated-parent {
    position: relative !important;
    z-index: 9999 !important;
  }
  .tour-help-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(6, 182, 212, 0.1);
    color: var(--accent-cyan);
    border: 1px solid var(--accent-cyan);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .tour-help-btn:hover {
    background: rgba(6, 182, 212, 0.2);
    transform: translateY(-2px);
  }
</style>

<div id="udecia-tour-overlay"></div>
<div id="udecia-tour-dialog">
  <img id="tour-img" src="/img/mascota/saludar.png" style="width:100px; height:auto; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));">
  <div style="flex:1;">
    <h3 id="tour-title" style="margin-top:0; margin-bottom:8px; color:var(--accent-cyan); font-size:1.3rem;">Título</h3>
    <p id="tour-text" style="font-size:1rem; margin-bottom:15px; color:var(--text-primary); line-height:1.4;">Texto</p>
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div style="display:flex; gap:0.5rem; align-items:center;">
        <button id="tour-skip" style="background:none; border:none; color:var(--text-muted); text-decoration:underline; cursor:pointer; font-size:0.85rem; padding:0.4rem;" onclick="closeTour()">Saltar</button>
        <button id="tour-prev" class="btn-secondary" style="padding:0.4rem 1rem; font-size:0.9rem;" onclick="tourChangeStep(-1)">Anterior</button>
      </div>
      <span id="tour-progress" style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">1/5</span>
      <button id="tour-next" class="btn-primary" style="padding:0.4rem 1rem; font-size:0.9rem;" onclick="tourChangeStep(1)">Siguiente</button>
    </div>
  </div>
</div>

<script>
  let activeTourSteps = [];
  let currentTourStep = 0;

  function startUdeciaTour(steps) {
    if(!steps || steps.length === 0) return;
    activeTourSteps = steps;
    document.getElementById('udecia-tour-overlay').style.display = 'block';
    document.getElementById('udecia-tour-dialog').style.display = 'flex';
    currentTourStep = 0;
    renderTourStep();
  }

  function tourChangeStep(dir) {
    currentTourStep += dir;
    if (currentTourStep >= activeTourSteps.length) {
        closeTour();
    } else {
        renderTourStep();
    }
  }

  function closeTour() {
    document.getElementById('udecia-tour-overlay').style.display = 'none';
    document.getElementById('udecia-tour-dialog').style.display = 'none';
    clearTourHighlights();
  }

  function clearTourHighlights() {
    document.querySelectorAll('.tour-highlighted-element').forEach(el => el.classList.remove('tour-highlighted-element'));
    document.querySelectorAll('.tour-elevated-parent').forEach(el => el.classList.remove('tour-elevated-parent'));
  }

  function elevateParents(el) {
    let parent = el.parentElement;
    while(parent && parent.tagName !== 'BODY') {
        const style = window.getComputedStyle(parent);
        // Si el padre tiene un contexto de apilamiento, elevarlo
        if(style.position !== 'static' || style.display === 'flex' || style.display === 'grid') {
            parent.classList.add('tour-elevated-parent');
        }
        parent = parent.parentElement;
    }
  }

  function renderTourStep() {
    clearTourHighlights();

    const step = activeTourSteps[currentTourStep];
    
    if (step.el) {
        let targetEl = document.querySelector(step.el);
        if (targetEl && step.el.includes('Value')) {
            targetEl = targetEl.parentElement; 
        }
        
        if (targetEl) {
            targetEl.classList.add('tour-highlighted-element');
            elevateParents(targetEl);
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    document.getElementById('tour-img').src = step.img;
    document.getElementById('tour-title').innerText = step.title;
    document.getElementById('tour-text').innerText = step.text;
    document.getElementById('tour-progress').innerText = (currentTourStep + 1) + ' / ' + activeTourSteps.length;
    
    document.getElementById('tour-prev').style.visibility = currentTourStep === 0 ? 'hidden' : 'visible';
    document.getElementById('tour-next').innerText = currentTourStep === activeTourSteps.length - 1 ? '¡Finalizar!' : 'Siguiente';
  }
</script>
