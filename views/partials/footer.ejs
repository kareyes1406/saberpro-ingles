    </main>
    
    <footer style="text-align:center; padding:1rem; color:var(--text-muted); font-size:0.75rem;">
        SaberPro Inglés v1.0 — Plataforma de Preparación Gamificada © 2026
    </footer>

    <!-- Mascota Interactiva (Husky) -->
    <% if (typeof user !== 'undefined' && user) { %>
    <div id="mascotaContainer">
        <div id="mascotaTooltip"></div>
        <img id="mascotaImg" src="/img/mascota/idle.png" alt="Mascota Husky">
    </div>
    <% } %>

    <!-- Shared Modals & Mascota CSS/JS -->
    <link rel="stylesheet" href="/css/modals.css">
    <script src="/js/mascotaController.js?v=<%= Date.now() %>"></script>
    
    <% if (typeof jsFile !== 'undefined' && jsFile) { %>
        <% const gameFiles = ['vocabulary.js', 'reading.js', 'pragmatics.js', 'grammar.js', 'boss-battle.js', 'exam.js']; %>
        <% if (gameFiles.includes(jsFile)) { %>
            <script src="/js/anti-cheat.js?v=<%= Date.now() %>"></script>
        <% } %>
        <script src="/js/<%= jsFile %>?v=<%= Date.now() %>"></script>
    <% } %>
</body>
</html>
