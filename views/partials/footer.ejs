    </main>
    
    <footer style="text-align:center; padding:1rem; color:var(--text-muted); font-size:0.75rem;">
        SaberPro Inglés v2.0 — Plataforma de Preparación Gamificada © 2026
    </footer>

    <!-- UDECIA - Compañera de Entrenamiento (Desplegable / Minimizables) -->
    <% if (typeof user !== 'undefined' && user) { %>
    <div id="mascotaContainer">
        <div id="mascotaTooltip"></div>
        <button id="mascotaToggleBtn" class="mascota-toggle-btn" title="Minimizar / Ocultar a UDECIA" onclick="toggleMascotaVisibility(event)">✕</button>
        <img id="mascotaImg" src="/img/mascota/idle.png" alt="UDECIA - Tu compañera de entrenamiento">
    </div>

    <!-- Botón desplegable para mostrar a UDECIA cuando esté oculta -->
    <button id="mascotaRestoreBtn" class="mascota-restore-btn" title="Mostrar a UDECIA" onclick="toggleMascotaVisibility(event)" style="display: none;">
        👩‍🦰 UDECIA
    </button>

    <!-- Chat Flotante con UDECIA y Docentes (Posicionado a un lado para no solaparse) -->
    <link rel="stylesheet" href="/css/chat-widget.css">
    <script src="/js/chat-widget.js?v=<%= Date.now() %>"></script>
    <% } %>

    <!-- Shared Modals & UDECIA CSS/JS -->
    <link rel="stylesheet" href="/css/modals.css">
    <script src="/js/mascotaController.js?v=<%= Date.now() %>"></script>
    
    <% if (typeof jsFile !== 'undefined' && jsFile) { %>
        <% const gameFiles = ['vocabulary.js', 'reading.js', 'pragmatics.js', 'grammar.js', 'boss-battle.js', 'exam.js']; %>
        <% if (gameFiles.includes(jsFile)) { %>
            <script src="/js/anti-cheat.js?v=<%= Date.now() %>"></script>
        <% } %>
        <script src="/js/<%= jsFile %>?v=<%= Date.now() %>"></script>
    <% } %>
</body>
</html>
