{
  "name": "saberpro-ingles",
  "version": "1.0.0",
  "description": "Plataforma gamificada Saber Pro - Módulo Inglés",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "cross-env NODE_ENV=test jest --verbose --forceExit --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit --verbose --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=tests/integration --verbose --forceExit --detectOpenHandles",
    "test:security": "cross-env NODE_ENV=test jest --testPathPatterns=tests/security --verbose --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --verbose --forceExit --detectOpenHandles",
    "test:report": "cross-env NODE_ENV=test jest --verbose --forceExit --detectOpenHandles && echo Reporte generado en test-report/reporte-tests.html",
    "audit": "npm audit --production"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "mssql": "^12.7.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-html-reporters": "^3.1.7",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
